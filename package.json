{
  "name": "ulpiano-cco",
  "version": "1.2.0",
  "description": "Portal de ciberseguridad procesal e integridad digital - Ulpiano CCO",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "lint": "eslint src/scripts/viewer.js \"src/modules/*.js\" src/lib/*.js tests/*.js",
    "test": "node --test",
    "format": "prettier --write \"**/*.{js,css,html,json,astro}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "astro": "^7.4.7",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^1.1.2"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
