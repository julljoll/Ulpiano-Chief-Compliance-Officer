---
/**
 * USWDS Component: Diagrams Sheet (Planilla de Modelado Arquitectónico)
 * Fuente oficial: https://designsystem.digital.gov/components/button-group/
 * Fuente oficial: https://designsystem.digital.gov/components/card/
 */
import { DIAGRAMS_REGISTRY } from '../../modules/diagrams-registry.js';

const diagramsList = Object.values(DIAGRAMS_REGISTRY);
const activeDiagram = DIAGRAMS_REGISTRY.master || diagramsList[0] || {};
---

<section id="view-diagrams" class="usa-section" data-view="diagrams" hidden>
  <div class="grid-container">
    <!-- 1. INTRODUCCIÓN Y ENCABEZADO (Hero Pattern) -->
    <div class="usa-hero margin-bottom-4" aria-label="Introducción a la Suite de Diagramas">
      <div class="grid-container">
        <div class="usa-hero__callout">
          <nav class="usa-breadcrumb margin-bottom-2" aria-label="Migas de pan">
            <ol class="usa-breadcrumb__list">
              <li class="usa-breadcrumb__list-item">
                <a href="index.html#dashboard" class="usa-breadcrumb__link">
                  Portal CCO
                </a>
              </li>
              <li class="usa-breadcrumb__list-item">
                <span class="usa-breadcrumb__link">Modelado Arquitectónico</span>
              </li>
              <li class="usa-breadcrumb__list-item usa-current" aria-current="page">
                <span id="diagram-breadcrumb-title">Suite de Diagramas V-1.2</span>
              </li>
            </ol>
          </nav>

          <span class="usa-tag margin-bottom-1">INGENIERÍA JUDICIAL FORENSE</span>
          <h1 class="usa-hero__heading" id="diagram-hero-title">
            Suite Oficial de Diagramas de Arquitectura &amp; Compliance
          </h1>
          <p id="diagram-hero-desc">
            Visualización interactiva en alta definición de la arquitectura técnica, el marco legal
            internacional (UE 2023/2841, FISMA 2014 S.2521, JTC Courts 2025), el marco legal
            nacional (CRBV Art. 203, Sentencia TSJ N° 0406/2026, LOCOTA 2026) y el aporte original
            de integridad procesal (Título VII).
          </p>

          <div class="margin-top-3 display-flex flex-wrap flex-gap-2">
            <button
              type="button"
              class="usa-button"
              onclick="window.UlpianoDash?.downloadActiveDiagram()"
            >
              Descargar SVG
            </button>
            <button
              type="button"
              class="usa-button usa-button--outline"
              onclick="window.UlpianoDash?.switchView('dashboard')"
            >
              Volver al Dashboard
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. RESUMEN DE PERSPECTIVAS Y ESTÁNDARES -->
    <div class="display-flex flex-wrap flex-gap-1 margin-bottom-4">
      <span class="usa-tag">V-1.2 Actualizada (FISMA &amp; LOCOTA)</span>
      <span class="usa-tag">Zero Trust &amp; WORM SHA-256</span>
      <span class="usa-tag">UE 2023/2841 &amp; JTC NCSC 2025</span>
      <span class="usa-tag">CRBV 203 &amp; TSJ 0406/2026</span>
      <span class="usa-tag">ISO/IEC 27001 / 27037 / 42001</span>
    </div>

    <!-- 3. SELECTOR DE PERSPECTIVAS (9 PESTAÑAS) -->
    <div class="margin-bottom-4" id="diagram-nav-tabs">
      <p class="font-sans-xs text-bold text-uppercase text-base margin-bottom-1">
        Seleccionar Perspectiva Arquitectónica:
      </p>
      <ul class="usa-button-group usa-button-group--segmented">
        {diagramsList.map((diag, index) => (
          <li class="usa-button-group__item">
            <button
              type="button"
              class={`usa-button ${index === 0 ? '' : 'usa-button--outline'} diagram-tab-btn`}
              data-tab={diag.id}
              onclick={`window.UlpianoDash?.switchDiagramTab('${diag.id}')`}
            >
              <span>{diag.name}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <!-- 4. VISOR INTERACTIVO Y CONTROLES DE HERRAMIENTAS -->
    <div class="usa-card margin-bottom-5">
      <div class="usa-card__container">
        <header class="usa-card__header border-bottom-1px border-base-lighter padding-bottom-2">
          <div class="display-flex flex-wrap flex-justify flex-align-center flex-gap-2">
            <div>
              <h2 class="font-sans-md margin-0" id="diagram-active-name">
                {activeDiagram.name}
              </h2>
              <p
                class="font-sans-2xs text-base margin-top-05 margin-bottom-0"
                id="diagram-active-sub"
              >
                {activeDiagram.sub}
              </p>
            </div>
            <div class="display-flex flex-wrap flex-gap-1">
              <button
                type="button"
                class="usa-button usa-button--small usa-button--outline"
                onclick="window.UlpianoDash?.zoomDiagram(-0.15)"
                title="Reducir zoom"
              >
                Zoom -
              </button>
              <button
                type="button"
                class="usa-button usa-button--small usa-button--outline"
                id="diagram-zoom-level-btn"
                onclick="window.UlpianoDash?.resetDiagramZoom()"
                title="Restablecer zoom al 100%"
              >
                <span id="diagram-zoom-val">100%</span>
              </button>
              <button
                type="button"
                class="usa-button usa-button--small usa-button--outline"
                onclick="window.UlpianoDash?.zoomDiagram(0.15)"
                title="Aumentar zoom"
              >
                Zoom +
              </button>
              <button
                type="button"
                class="usa-button usa-button--small usa-button--outline"
                id="btn-diagram-fullscreen"
                onclick="window.UlpianoDash?.toggleDiagramFullscreen()"
                title="Pantalla completa"
              >
                Pantalla Completa
              </button>
              <button
                type="button"
                class="usa-button usa-button--small"
                onclick="window.UlpianoDash?.openActiveDiagramNewTab()"
                title="Abrir en pestaña independiente"
              >
                Abrir SVG ↗
              </button>
            </div>
          </div>
        </header>

        <div class="usa-card__body padding-2">
          <div
            id="diagram-viewport-content"
            class="padding-3 bg-base-lightest border-1px border-base-lighter text-center overflow-auto"
          >
            <p class="font-sans-sm text-base">Cargando diagrama vectorial en alta resolución...</p>
          </div>
        </div>
      </div>
    </div>

    <!-- 5. DESGLOSE DE CAPAS DEL DIAGRAMA ACTIVO -->
    <div id="diagram-breakdown-section" class="margin-bottom-5">
      <div class="border-bottom-1px border-base-lighter padding-bottom-1 margin-bottom-3">
        <h2 class="font-sans-lg margin-0">Desglose por Capas y Especificación Técnica</h2>
      </div>

      <ul class="usa-card-group">
        {activeDiagram.breakdown?.map((item) => (
          <li class="usa-card desktop:grid-col-3 tablet:grid-col-6">
            <div class="usa-card__container">
              <header class="usa-card__header">
                <span class="usa-tag margin-bottom-1">{item.badge}</span>
                <h3 class="usa-card__heading font-sans-sm">{item.title}</h3>
              </header>
              <div class="usa-card__body">
                <p class="font-sans-2xs text-base">{item.desc}</p>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
