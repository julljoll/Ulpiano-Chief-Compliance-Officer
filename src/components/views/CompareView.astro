---
/**
 * USWDS Component: Compare Sheet (Planilla de Comparador Diferencial de Versiones)
 * Fuente oficial: https://designsystem.digital.gov/components/prose/
 * Fuente oficial: https://designsystem.digital.gov/components/select/
 */
import registryData from '../../../registry.json';

const allDocs = Array.isArray(registryData) ? registryData : [];
---

<section id="view-compare" class="usa-section" data-view="compare" hidden>
  <div class="grid-container">
    <!-- 1. ENCABEZADO Y CONTROLES -->
    <div class="display-flex flex-wrap flex-justify flex-align-center flex-gap-2 margin-bottom-4">
      <div>
        <h1 class="font-sans-xl margin-0">
          Comparador de Versiones &amp; Trazabilidad Legislativa
        </h1>
        <p class="font-sans-sm text-base margin-top-05 margin-bottom-0">
          Contraste simultáneo entre versiones del anteproyecto. Resaltados en rojo indican reformas
          V-1.1; en azul, integraciones federales FISMA y celeridad LOCOTA V-1.2.
        </p>
      </div>
      <button
        type="button"
        class="usa-button usa-button--outline usa-button--small"
        onclick="window.UlpianoDash?.switchView('dashboard')"
      >
        Volver al Dashboard
      </button>
    </div>

    <!-- 2. SELECTORES DE VERSIÓN Y BOTÓN INVERTIR -->
    <div
      class="padding-3 bg-base-lightest border-1px border-base-lighter margin-bottom-4"
      id="compare-version-picker"
    >
      <div class="grid-row grid-gap-3 flex-align-end">
        <!-- Panel Izquierdo -->
        <div class="tablet:grid-col-5">
          <label for="compare-select-left" class="usa-label text-bold font-sans-xs text-uppercase">
            Panel Izquierdo (Base):
          </label>
          <select
            id="compare-select-left"
            class="usa-select margin-0 version-select-auto"
            title="Seleccionar versión izquierda"
          >
            {allDocs.map((doc, idx) => (
              <option value={doc.id} selected={idx === allDocs.length - 1}>
                {doc.badgeText || doc.label}
              </option>
            ))}
          </select>
        </div>

        <!-- Botón Invertir -->
        <div class="tablet:grid-col-2 text-center">
          <button
            type="button"
            id="btn-compare-swap"
            class="usa-button usa-button--outline width-full"
            title="Intercambiar paneles"
            onclick="window.UlpianoDash?.swapComparePanels()"
          >
            ⇄ Invertir
          </button>
        </div>

        <!-- Panel Derecho -->
        <div class="tablet:grid-col-5">
          <label for="compare-select-right" class="usa-label text-bold font-sans-xs text-uppercase">
            Panel Derecho (Contraste):
          </label>
          <select
            id="compare-select-right"
            class="usa-select margin-0 version-select-auto"
            title="Seleccionar versión derecha"
          >
            {allDocs.map((doc, idx) => (
              <option value={doc.id} selected={idx === 0}>
                {doc.badgeText || doc.label}
              </option>
            ))}
          </select>
        </div>
      </div>

      <div class="margin-top-3 border-top-1px border-base-lighter padding-top-2 display-flex flex-wrap flex-justify flex-align-center flex-gap-2">
        <button type="button" class="usa-button" onclick="window.UlpianoDash?.runCompare()">
          Ejecutar Comparación Paralela
        </button>
        <span class="font-sans-xs text-base" id="compare-status-msg">
          Listo para comparar texto normativo.
        </span>
      </div>
    </div>

    <!-- 3. PANELES DE LECTURA DIVIDIDA (USWDS Prose) -->
    <div class="grid-row grid-gap-4">
      <div class="tablet:grid-col-6">
        <div class="padding-2 bg-base-lightest border-1px border-base-lighter margin-bottom-2 display-flex flex-justify flex-align-center">
          <strong class="font-sans-xs" id="compare-left-title">
            Panel Base
          </strong>
          <span class="usa-tag" id="compare-left-badge">
            V1.0
          </span>
        </div>
        <div
          class="usa-prose padding-3 bg-white border-1px border-base-lighter shadow-1 overflow-auto"
          id="compare-left-paper"
        >
          <p class="font-sans-sm text-base">Cargando texto normativo base...</p>
        </div>
      </div>

      <div class="tablet:grid-col-6">
        <div class="padding-2 bg-base-lightest border-1px border-base-lighter margin-bottom-2 display-flex flex-justify flex-align-center">
          <strong class="font-sans-xs" id="compare-right-title">
            Panel Contraste
          </strong>
          <span class="usa-tag" id="compare-right-badge">
            V1.2
          </span>
        </div>
        <div
          class="usa-prose padding-3 bg-white border-1px border-base-lighter shadow-1 overflow-auto"
          id="compare-right-paper"
        >
          <p class="font-sans-sm text-base">Cargando texto normativo de contraste...</p>
        </div>
      </div>
    </div>
  </div>
</section>
