---
/**
 * Ulpiano CCO — Normative Traceability Matrix View (Astro + TypeScript)
 * Mapeo sistemático entre los 11 Títulos, Estándares Internacionales y Bloque Constitucional
 * USWDS 3.0 Strict Compliance
 */
import { MATRIX_ROWS } from '../../lib/legal';
---

<section id="view-matrix" class="usa-section" data-view="matrix" hidden>
  <div class="grid-container">
    <!-- Header -->
    <div class="grid-row grid-gap flex-align-start margin-bottom-4">
      <div class="tablet:grid-col-8">
        <h1 class="usa-heading-xl margin-bottom-1">
          Matriz de Trazabilidad Normativa y Estándares Forenses
        </h1>
        <p class="usa-intro margin-top-1 text-base">
          Mapeo sistemático y auditable entre los 11 Títulos del Anteproyecto, el derecho comparado
          (UE 2023/2841, FISMA 2014 S.2521, JTC Courts 2025), estándares internacionales ISO/IEC y
          el bloque constitucional venezolano (CRBV Art. 203 y Sentencia TSJ 0406/2026).
        </p>
      </div>
      <div class="tablet:grid-col-4 display-flex flex-justify-end flex-align-center">
        <button
          type="button"
          class="usa-button usa-button--outline"
          onclick="window.UlpianoDash?.switchView('dashboard')"
        >
          Volver al Dashboard
        </button>
      </div>
    </div>

    <!-- Summary Standard Badges -->
    <div class="display-flex flex-wrap gap-1 margin-bottom-3" aria-label="Estándares de Referencia">
      <span class="usa-tag bg-primary-dark">11 Títulos + Disposiciones</span>
      <span class="usa-tag bg-info">UE 2023/2841 (CERT-EU)</span>
      <span class="usa-tag bg-success">JTC NCSC 2025 (Cortes)</span>
      <span class="usa-tag bg-primary">FISMA 2014 S.2521 (PSS &amp; DOV)</span>
      <span class="usa-tag bg-secondary-dark">TSJ Sentencia 0406/2026 &amp; LOCOTA 2026</span>
      <span class="usa-tag bg-warning">ISO/IEC 27001 / 27037 / 42001</span>
      <span class="usa-tag bg-secondary">CRBV Art. 203 (Rango Orgánico)</span>
    </div>

    <!-- Toolbar: Search Bar, Category Filter Buttons & Export Actions -->
    <div class="usa-card margin-bottom-4">
      <div class="usa-card__container padding-3">
        <div class="grid-row grid-gap flex-align-center">
          <div class="tablet:grid-col-6">
            <div class="usa-search usa-search--small" role="search">
              <label class="usa-sr-only" for="matrix-search-input">
                Filtrar por término en la matriz
              </label>
              <input
                class="usa-input"
                id="matrix-search-input"
                type="search"
                name="search"
                placeholder="Filtrar por término (ej. LOCOTA, FISMA, ISO, 0406, 203)..."
              />
              <button class="usa-button" type="button" aria-label="Buscar">
                <span class="usa-search__submit-text">Buscar</span>
              </button>
            </div>
          </div>

          <div class="tablet:grid-col-6 display-flex flex-justify-end flex-wrap flex-align-center gap-1">
            <span class="text-base font-sans-xs margin-right-1" id="matrix-filter-count">
              Mostrando <strong>12</strong> filas normativas en cuadrícula
            </span>
            <button
              type="button"
              class="usa-button usa-button--outline font-sans-xs"
              onclick="window.UlpianoDash?.exportMatrixCSV()"
              title="Descargar como archivo CSV compatible con Excel"
            >
              Exportar CSV
            </button>
            <button
              type="button"
              class="usa-button usa-button--outline font-sans-xs"
              onclick="window.UlpianoDash?.copyMatrixTable()"
              title="Copiar al portapapeles en formato TSV"
            >
              Copiar Tabla
            </button>
            <button
              type="button"
              class="usa-button usa-button--outline font-sans-xs"
              onclick="window.print()"
              title="Imprimir Matriz"
            >
              Imprimir
            </button>
          </div>
        </div>

        <!-- Category Filter Pills -->
        <div
          class="usa-button-group margin-top-2 border-top-1px border-base-lighter padding-top-2"
          role="group"
          aria-label="Filtro por sección"
        >
          <button
            type="button"
            class="usa-button usa-button--outline excel-sheet-tab active"
            data-sheet="all"
            onclick="window.UlpianoDash?.filterMatrixBySheet('all')"
          >
            Todas las Secciones
          </button>
          <button
            type="button"
            class="usa-button usa-button--outline excel-sheet-tab"
            data-sheet="organica"
            onclick="window.UlpianoDash?.filterMatrixBySheet('organica')"
          >
            Ley Orgánica &amp; Constitucional (Art. 203)
          </button>
          <button
            type="button"
            class="usa-button usa-button--outline excel-sheet-tab"
            data-sheet="fisma"
            onclick="window.UlpianoDash?.filterMatrixBySheet('fisma')"
          >
            Gobernanza FISMA 2014 &amp; UE
          </button>
          <button
            type="button"
            class="usa-button usa-button--outline excel-sheet-tab"
            data-sheet="original"
            onclick="window.UlpianoDash?.filterMatrixBySheet('original')"
          >
            Aporte Original Título VII (Anticorrupción)
          </button>
          <button
            type="button"
            class="usa-button usa-button--outline excel-sheet-tab"
            data-sheet="forense"
            onclick="window.UlpianoDash?.filterMatrixBySheet('forense')"
          >
            Forense Digital ISO 27037 &amp; Sanciones
          </button>
        </div>
      </div>
    </div>

    <!-- Table Container -->
    <div class="usa-table-container--scrollable margin-bottom-6" tabindex="0">
      <table
        class="usa-table usa-table--striped usa-table--borderless width-full"
        id="matrix-table-main"
      >
        <thead>
          <tr>
            <th scope="col" class="text-center">
              Fila
            </th>
            <th scope="col">Título &amp; Artículos</th>
            <th scope="col">Materia Regulada &amp; Alcance</th>
            <th scope="col">Derecho Comparado / Estándares</th>
            <th scope="col">Bloque Constitucional &amp; Nacional</th>
            <th scope="col" class="text-center">
              Jerarquía
            </th>
          </tr>
        </thead>
        <tbody id="matrix-tbody">
          {MATRIX_ROWS.map((row) => (
            <tr data-category={row.category} class={row.isStar ? 'bg-gold-light' : ''}>
              <td class="text-center text-bold font-mono-sm">
                {row.rowNum}
                {row.isStar && '★'}
              </td>
              <td>
                <span class="usa-tag bg-primary-lighter text-primary-darker text-bold margin-bottom-05">
                  {row.titleId}
                </span>
                <div class="text-bold text-ink">{row.titleName}</div>
                <span class="text-base font-sans-xs">{row.articles}</span>
              </td>
              <td>
                <div class="text-bold text-ink margin-bottom-05">{row.topic}</div>
                <p class="font-sans-xs text-base-dark line-height-sans-3 margin-0">{row.scope}</p>
              </td>
              <td>
                <ul class="usa-list usa-list--unstyled margin-0 font-sans-xs">
                  {row.comparativeLaw.map((item) => (
                    <li class="margin-bottom-05">
                      <span
                        class={`usa-tag ${item.isOriginal ? 'bg-secondary' : 'bg-accent-cool-lighter text-ink'} margin-right-05`}
                      >
                        {item.tag}
                      </span>
                      <span>{item.detail}</span>
                    </li>
                  ))}
                </ul>
              </td>
              <td>
                <ul class="usa-list usa-list--unstyled margin-0 font-sans-xs">
                  {row.constitutionalBlock.map((item) => (
                    <li class="margin-bottom-05">
                      <span
                        class={`usa-tag ${item.isImportant ? 'bg-secondary text-white' : 'bg-base-lighter text-ink'} margin-right-05`}
                      >
                        {item.tag}
                      </span>
                      <span class={item.isImportant ? 'text-bold text-secondary-dark' : ''}>
                        {item.detail}
                      </span>
                    </li>
                  ))}
                </ul>
              </td>
              <td class="text-center">
                <span
                  class={`usa-tag ${row.hierarchy === 'Orgánica' ? 'bg-secondary text-white' : row.hierarchy === 'Innovación' ? 'bg-gold text-ink' : 'bg-primary text-white'}`}
                >
                  {row.hierarchy}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
