---
/**
 * USWDS Component: Dashboard Sheet (Planilla de Control y Auditoría)
 * Fuente oficial: https://designsystem.digital.gov/components/card/
 * Fuente oficial: https://designsystem.digital.gov/components/table/
 */
import registryData from '../../../registry.json';
import { REFORMS_CATALOG } from '../../modules/registry.js';

const allDocs = Array.isArray(registryData) ? registryData : [];
const latestDoc = allDocs[0] || {};
---

<section id="view-dashboard" class="usa-section" data-view="dashboard">
  <div class="grid-container">
    <!-- 1. HERO EJECUTIVO (USWDS Hero Pattern) -->
    <div class="usa-hero margin-bottom-4" aria-label="Introducción Institucional">
      <div class="grid-container">
        <div class="usa-hero__callout">
          <nav class="usa-breadcrumb margin-bottom-2" aria-label="Migas de pan">
            <ol class="usa-breadcrumb__list">
              <li class="usa-breadcrumb__list-item">
                <a href="index.html#dashboard" class="usa-breadcrumb__link">
                  Portal CCO
                </a>
              </li>
              <li class="usa-breadcrumb__list-item">
                <span class="usa-breadcrumb__link">Auditoría Normativa</span>
              </li>
              <li class="usa-breadcrumb__list-item usa-current" aria-current="page">
                <span id="kpi-hero-breadcrumb">{latestDoc.label}</span>
              </li>
            </ol>
          </nav>

          <span class="usa-tag margin-bottom-1">RANGO ORGÁNICO ART. 203 CRBV</span>
          <h1 class="usa-hero__heading" id="kpi-hero-title">
            Auditoría de Integridad y Control de {latestDoc.shortLabel}
          </h1>
          <p id="kpi-hero-desc">{latestDoc.description}</p>

          <div class="margin-top-3 display-flex flex-wrap flex-gap-2">
            <button
              type="button"
              class="usa-button"
              id="kpi-hero-btn-reader"
              onclick="window.UlpianoDash?.openLatestDoc()"
            >
              <span id="kpi-hero-btn-label">Abrir Texto {latestDoc.shortLabel}</span>
            </button>
            <button
              type="button"
              class="usa-button usa-button--outline"
              onclick="window.UlpianoDash?.switchView('compare')"
            >
              Comparar Versiones
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. FUNDAMENTO DOGMÁTICO: LOS 3 AXIOMAS DE ULPIANO -->
    <div class="margin-bottom-5">
      <div class="border-bottom-1px border-base-lighter padding-bottom-1 margin-bottom-3">
        <span class="usa-tag">DOGMÁTICA Y DERECHO PROCESAL</span>
        <h2 class="font-sans-lg margin-top-1 margin-bottom-0">
          Los 3 Axiomas del Jurista Domicio Ulpiano en Código Criptográfico
        </h2>
      </div>

      <ul class="usa-card-group">
        <li class="usa-card tablet:grid-col-4">
          <div class="usa-card__container">
            <header class="usa-card__header">
              <span class="usa-tag">Art. 27 — Doble Firma</span>
              <h3 class="usa-card__heading">Honeste Vivere</h3>
              <p class="font-sans-xs text-italic text-base margin-top-05">Vivir Honestamente</p>
            </header>
            <div class="usa-card__body">
              <p>
                <strong>Segregación "4 Ojos Digital"</strong>: Doble firma obligatoria e indivisible
                (Juez + Secretario) y bitácoras inmutables WORM. Ningún funcionario puede alterar un
                fallo en solitario ni causar retardo procesal encubierto.
              </p>
            </div>
            <div class="usa-card__footer">
              <span class="font-sans-2xs text-bold text-primary">
                Incorruptibilidad Funcionarial
              </span>
            </div>
          </div>
        </li>

        <li class="usa-card tablet:grid-col-4">
          <div class="usa-card__container">
            <header class="usa-card__header">
              <span class="usa-tag">Arts. 13-bis &amp; 19-bis</span>
              <h3 class="usa-card__heading">Alterum Non Laedere</h3>
              <p class="font-sans-xs text-italic text-base margin-top-05">No Dañar al Otro</p>
            </header>
            <div class="usa-card__body">
              <p>
                <strong>Ciberdefensa Zero Trust</strong>: CSIRT-Ulpiano 24/7, MFA biométrico FIDO2,
                Planes de Seguridad del Sistema (PSS) anuales y Directivas Operativas Vinculantes
                (DOV) ejecutivas en 72 horas para blindar la tutela judicial efectiva.
              </p>
            </div>
            <div class="usa-card__footer">
              <span class="font-sans-2xs text-bold text-primary">
                Inmutabilidad Probatoria WORM
              </span>
            </div>
          </div>
        </li>

        <li class="usa-card tablet:grid-col-4">
          <div class="usa-card__container">
            <header class="usa-card__header">
              <span class="usa-tag">Art. 26 — Imparcialidad</span>
              <h3 class="usa-card__heading">Suum Cuique Tribuere</h3>
              <p class="font-sans-xs text-italic text-base margin-top-05">
                Dar a Cada Cual lo Suyo
              </p>
            </header>
            <div class="usa-card__body">
              <p>
                <strong>Sorteo Algorítmico CSPRNG</strong>: Asignación determinística e imparcial de
                causas, ponencias y trámites administrativos con semilla de entropía auditada en
                Árbol de Merkle, erradicando el amaño discrecional.
              </p>
            </div>
            <div class="usa-card__footer">
              <span class="font-sans-2xs text-bold text-primary">
                Equidad Algorítmica Imparcial
              </span>
            </div>
          </div>
        </li>
      </ul>
    </div>

    <!-- 3. CUATRO PANELES KPI DE RENDIMIENTO Y AUDITORÍA -->
    <div class="margin-bottom-5">
      <ul class="usa-card-group">
        <li class="usa-card tablet:grid-col-3">
          <div class="usa-card__container">
            <header class="usa-card__header">
              <h3 class="font-sans-xs text-uppercase text-base margin-0">
                Artículos del Anteproyecto
              </h3>
            </header>
            <div class="usa-card__body">
              <p class="font-sans-2xl text-bold text-primary margin-y-1" id="kpi-articles-num">
                {latestDoc.articlesCount || 47}
              </p>
              <span class="usa-tag" id="kpi-articles-tag">
                {latestDoc.titlesCount || '11 Títulos + Anexo'}
              </span>
            </div>
          </div>
        </li>

        <li class="usa-card tablet:grid-col-3" id="kpi-card-reforms">
          <div class="usa-card__container">
            <header class="usa-card__header">
              <h3 class="font-sans-xs text-uppercase text-base margin-0" id="kpi-reforms-label">
                Cláusulas FISMA &amp; LOCOTA (V-1.2)
              </h3>
            </header>
            <div class="usa-card__body">
              <p
                class="font-sans-2xl text-bold text-secondary-dark margin-y-1"
                id="kpi-reforms-num"
              >
                {latestDoc.changes || 14}
              </p>
              <span class="usa-tag" id="kpi-reforms-tag">
                Marcadas en Azul y Rojo
              </span>
            </div>
          </div>
        </li>

        <li class="usa-card tablet:grid-col-3">
          <div class="usa-card__container">
            <header class="usa-card__header">
              <h3 class="font-sans-xs text-uppercase text-base margin-0">Jerarquía Normativa</h3>
            </header>
            <div class="usa-card__body">
              <p class="font-sans-2xl text-bold text-primary margin-y-1" id="kpi-hierarchy-num">
                {latestDoc.hierarchy || 'Orgánica'}
              </p>
              <span class="usa-tag" id="kpi-hierarchy-tag">
                Art. 203 CRBV (TSJ 0406/2026)
              </span>
            </div>
          </div>
        </li>

        <li class="usa-card tablet:grid-col-3">
          <div class="usa-card__container">
            <header class="usa-card__header">
              <h3 class="font-sans-xs text-uppercase text-base margin-0">
                Cobertura de la Vida Jurídica
              </h3>
            </header>
            <div class="usa-card__body">
              <p class="font-sans-2xl text-bold text-success margin-y-1" id="kpi-coverage-num">
                100% Pleno
              </p>
              <span class="usa-tag" id="kpi-coverage-tag">
                Judicial + Adm. Pública + LOCOTA
              </span>
            </div>
          </div>
        </li>
      </ul>
    </div>

    <!-- 4. CATÁLOGO DE VERSIONES DE LA LEY ORGÁNICA (USWDS Cards) -->
    <div class="margin-bottom-5">
      <div class="border-bottom-1px border-base-lighter padding-bottom-1 margin-bottom-3">
        <h2 class="font-sans-lg margin-0">Catálogo y Control de Versiones del Anteproyecto</h2>
        <p class="font-sans-sm text-base margin-top-05">
          Evolución técnico-legislativa registrada en registro oficial normativo
        </p>
      </div>

      <ul class="usa-card-group" id="version-cards-grid">
        {allDocs.map((doc) => (
          <li class="usa-card tablet:grid-col-4">
            <div class="usa-card__container">
              <header class="usa-card__header">
                <div class="display-flex flex-justify flex-align-center margin-bottom-1">
                  <span class="usa-tag">{doc.shortLabel || doc.label}</span>
                  <span class="font-sans-2xs text-base">{doc.date}</span>
                </div>
                <h3 class="usa-card__heading font-sans-md">{doc.label}</h3>
              </header>
              <div class="usa-card__body">
                <p class="font-sans-xs text-base">{doc.description}</p>
                <div class="display-flex flex-wrap flex-gap-1 margin-top-2">
                  {doc.highlights?.map((h) => (
                    <span class="usa-tag">{h}</span>
                  ))}
                </div>
              </div>
              <div class="usa-card__footer display-flex flex-justify flex-align-center">
                <button
                  type="button"
                  class="usa-button usa-button--small"
                  onclick={`window.UlpianoDash?.loadDoc('${doc.id}')`}
                >
                  Abrir en Lector
                </button>
                {doc.changes > 0 ? (
                  <span class="usa-tag">{doc.changes} Reformas</span>
                ) : (
                  <span class="font-sans-2xs text-base">Texto Base</span>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- 5. DESGLOSE DE LAS GRANDES REFORMAS ESTRUCTURALES -->
    <div class="margin-bottom-5">
      <div class="border-bottom-1px border-base-lighter padding-bottom-1 margin-bottom-3">
        <h2 class="font-sans-lg margin-0" id="core-reforms-section-title">
          Desglose de las 3 Grandes Reformas Estructurales ({latestDoc.shortLabel})
        </h2>
      </div>

      <ul class="usa-card-group" id="core-reforms-grid">
        {latestDoc.coreReforms?.map((ref) => (
          <li class="usa-card tablet:grid-col-4">
            <div class="usa-card__container">
              <header class="usa-card__header">
                <div class="display-flex flex-justify flex-align-center margin-bottom-1">
                  <span class="usa-tag">{ref.tag}</span>
                  <span class="font-sans-2xs text-base">{ref.articles}</span>
                </div>
                <h3 class="usa-card__heading font-sans-md">{ref.title}</h3>
              </header>
              <div class="usa-card__body">
                <p class="font-sans-xs text-base margin-bottom-2">{ref.desc}</p>
                <div class="padding-2 bg-base-lightest border-1px border-base-lighter margin-bottom-2">
                  <p class="font-sans-2xs margin-0 margin-bottom-1">
                    <strong>Antes:</strong> {ref.before}
                  </p>
                  <p class="font-sans-2xs margin-0">
                    <strong>Ahora:</strong> {ref.after}
                  </p>
                </div>
              </div>
              <div class="usa-card__footer">
                <span class="font-sans-2xs text-bold text-primary">{ref.benefit}</span>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- 6. VISTA PREVIA DEL DIAGRAMA MAESTRO VECTORIAL -->
    <div class="usa-card margin-bottom-5">
      <div class="usa-card__container">
        <header class="usa-card__header border-bottom-1px border-base-lighter padding-bottom-2">
          <div class="display-flex flex-wrap flex-justify flex-align-center flex-gap-2">
            <div>
              <h2 class="font-sans-lg margin-0">Arquitectura Maestra de Integración V-1.2</h2>
              <p class="font-sans-xs text-base margin-top-05 margin-bottom-0">
                Reglamento UE 2023/2841, FISMA 2014 S.2521 y JTC Courts 2025 vs. Aporte Original
                Título VII.
              </p>
            </div>
            <div class="display-flex flex-wrap flex-gap-1">
              <a
                href="./svg/ciberseguridad_integracion_V1.2.svg"
                target="_blank"
                rel="noopener noreferrer"
                class="usa-button usa-button--small"
              >
                Ver SVG Completo
              </a>
              <button
                type="button"
                class="usa-button usa-button--small usa-button--outline"
                onclick="window.UlpianoDash?.switchDiagramTab('master'); window.UlpianoDash?.switchView('diagrams');"
              >
                Explorar en Visor
              </button>
            </div>
          </div>
        </header>
        <div class="usa-card__body padding-2">
          <div
            id="dashboard-svg-container"
            class="padding-2 bg-base-lightest border-1px border-base-lighter text-center overflow-auto"
          >
            <!-- Renderizado dinámico del diagrama -->
          </div>
        </div>
      </div>
    </div>

    <!-- 7. PANELES DE ANÁLISIS Y GRÁFICOS -->
    <div class="grid-row grid-gap-4 margin-bottom-5">
      <div class="tablet:grid-col-6">
        <div class="usa-card__container padding-3 border-1px border-base-lighter">
          <div class="display-flex flex-justify flex-align-center margin-bottom-2 border-bottom-1px border-base-lighter padding-bottom-1">
            <h3 class="font-sans-sm text-uppercase margin-0">Distribución de Reformas</h3>
            <span class="usa-tag" id="chart-reforms-version-tag">
              Versión 1.2
            </span>
          </div>
          <canvas id="chartReformsDistribution"></canvas>
        </div>
      </div>
      <div class="tablet:grid-col-6">
        <div class="usa-card__container padding-3 border-1px border-base-lighter">
          <div class="display-flex flex-justify flex-align-center margin-bottom-2 border-bottom-1px border-base-lighter padding-bottom-1">
            <h3 class="font-sans-sm text-uppercase margin-0">Ámbito de Aplicación</h3>
            <span class="usa-tag">Cobertura 100% Plena</span>
          </div>
          <canvas id="chartScope"></canvas>
        </div>
      </div>
    </div>

    <!-- 8. EXPLORADOR DELTA DE MODIFICACIONES (USWDS Table & Search) -->
    <div class="margin-bottom-5">
      <div class="border-bottom-1px border-base-lighter padding-bottom-2 margin-bottom-3">
        <div class="display-flex flex-wrap flex-justify flex-align-center flex-gap-2">
          <div>
            <h2 class="font-sans-lg margin-0">
              Explorador Detallado de Modificaciones (Delta Inspector)
            </h2>
            <p class="font-sans-xs text-base margin-top-05 margin-bottom-0">
              Auditoría de las 14 modificaciones estructurales introducidas en V-1.2 (S.2521 FISMA
              2014, LOCOTA 2026, TSJ 0406/2026).
            </p>
          </div>
          <div class="usa-search usa-search--small" role="search">
            <label class="usa-sr-only" for="delta-search-input">
              Buscar por artículo
            </label>
            <input
              class="usa-input"
              id="delta-search-input"
              type="search"
              name="search"
              placeholder="Buscar por artículo o término..."
            />
          </div>
        </div>
      </div>

      <div class="usa-table-container--scrollable" tabindex="0">
        <table class="usa-table usa-table--striped usa-table--borderless width-full">
          <caption class="usa-sr-only">Explorador de modificaciones entre versiones</caption>
          <thead>
            <tr>
              <th scope="col">Artículo / Sección</th>
              <th scope="col">Resumen Técnico</th>
              <th scope="col">Comparativa y Novedades</th>
              <th scope="col" class="text-right">
                Acción
              </th>
            </tr>
          </thead>
          <tbody id="delta-explorer-tbody">
            {REFORMS_CATALOG.map((ref) => (
              <tr>
                <th scope="row">
                  <span class="usa-tag margin-bottom-05">{ref.type}</span>
                  <div class="font-sans-xs text-bold">{ref.article}</div>
                </th>
                <td>
                  <p class="font-sans-xs margin-0">{ref.summary}</p>
                  <p class="font-sans-2xs text-base margin-top-05 margin-bottom-0">
                    <strong>Impacto:</strong> {ref.impact}
                  </p>
                </td>
                <td>
                  <div class="padding-1 bg-base-lightest border-1px border-base-lighter font-sans-2xs">
                    <div class="margin-bottom-05">
                      <strong>❌ {ref.beforeTag}:</strong> {ref.before}
                    </div>
                    <div>
                      <strong>✅ {ref.afterTag}:</strong> {ref.after}
                    </div>
                  </div>
                </td>
                <td class="text-right">
                  <button
                    type="button"
                    class="usa-button usa-button--small usa-button--outline"
                    onclick={`window.UlpianoDash?.loadDoc('${ref.targetDoc || 'v1.2'}')`}
                  >
                    Ver en Texto
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
