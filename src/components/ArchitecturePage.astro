---
/**
 * ULPIANO CCO — Shared Standalone Architecture Page Template (Backend Python & Frontend Next.js)
 * Compact Page Header with 1-click Backend <-> Frontend switcher so the interactive SVG diagram
 * renders immediately above the fold.
 */
import LegalLayout from '../layouts/LegalLayout.astro';
import Icon from './Icon.astro';
import SvgZoomViewer from './SvgZoomViewer.astro';
import type { ArchLayerItem } from '../types/legal.ts';

interface Props {
  pageTitle: string;
  pageDescription: string;
  activeSection: 'backend' | 'frontend';
  heroLabel: string;
  breadcrumbCurrent: string;
  heroTag: string;
  heroHeading: string;
  heroIntro: string;
  svgPath: string;
  svgDownloadName: string;
  svgAlt: string;
  viewerTag: string;
  viewerHeading: string;
  siblingHref: string;
  siblingLabel: string;
  layersHeading: string;
  layers: ArchLayerItem[];
}

const {
  pageTitle,
  pageDescription,
  activeSection,
  heroLabel,
  breadcrumbCurrent,
  heroTag,
  heroHeading,
  heroIntro,
  svgPath,
  svgDownloadName,
  svgAlt,
  viewerTag,
  viewerHeading,
  layersHeading,
  layers,
} = Astro.props;
---

<LegalLayout
  title={pageTitle}
  description={pageDescription}
  activeSection={activeSection}
>
  <!-- 1. COMPACT ARCHITECTURE PAGE HEADER WITH BACKEND/FRONTEND SWITCHER -->
  <section class="ulp-page-header" aria-label={heroLabel}>
    <div class="grid-container">
      <nav class="usa-breadcrumb" aria-label="Migas de pan">
        <ol class="usa-breadcrumb__list">
          <li class="usa-breadcrumb__list-item">
            <a href="/" class="usa-breadcrumb__link">Portal CCO</a>
          </li>
          <li class="usa-breadcrumb__list-item">
            <a href="/backend/" class="usa-breadcrumb__link">Arquitectura Técnica</a>
          </li>
          <li class="usa-breadcrumb__list-item usa-current" aria-current="page">
            <span>{breadcrumbCurrent}</span>
          </li>
        </ol>
      </nav>

      <div class="ulp-page-header__row">
        <div>
          <span class="usa-tag ulp-tag-v12 margin-bottom-05">{heroTag}</span>
          <h1 class="ulp-page-header__title">{heroHeading}</h1>
          <p class="ulp-page-header__sub">{heroIntro}</p>
        </div>

        <nav aria-label="Cambiar plano de arquitectura" class="ulp-segmented">
          <a
            href="/backend/"
            class={`ulp-segmented__item ${activeSection === 'backend' ? 'is-active' : ''}`}
            aria-current={activeSection === 'backend' ? 'page' : undefined}
          >
            <Icon name="terminal" size={15} />
            <span>Backend Python</span>
          </a>
          <a
            href="/frontend/"
            class={`ulp-segmented__item ${activeSection === 'frontend' ? 'is-active' : ''}`}
            aria-current={activeSection === 'frontend' ? 'page' : undefined}
          >
            <Icon name="code" size={15} />
            <span>Frontend Next.js</span>
          </a>
        </nav>
      </div>
    </div>
  </section>

  <!-- 2. INTERACTIVE VECTOR DIAGRAM + TECHNICAL LAYERS -->
  <section class="ulp-band ulp-band--subtle ulp-band--compact">
    <div class="grid-container">
      <SvgZoomViewer
        title={viewerHeading}
        tag={viewerTag}
        svgFile={svgPath}
        ariaLabel={svgAlt}
      />

      <div class="margin-top-4">
        <div class="ulp-section-head">
          <div>
            <span class="ulp-section-head__eyebrow">Desglose de Capas</span>
            <h2 class="ulp-section-head__title font-sans-lg">{layersHeading}</h2>
          </div>
          <a
            href={svgPath}
            download={svgDownloadName}
            class="usa-button usa-button--outline usa-button--small ulp-btn-icon"
          >
            <Icon name="download" size={15} />
            <span>Descargar Blueprint SVG</span>
          </a>
        </div>

        <ul class="usa-card-group">
          {layers.map((layer) => (
            <li class="usa-card desktop:grid-col-3 tablet:grid-col-6">
              <div class="usa-card__container">
                <header class="usa-card__header">
                  <span class="usa-tag ulp-tag-v12 margin-bottom-1">{layer.badge}</span>
                  <h3 class="usa-card__heading font-sans-sm">{layer.title}</h3>
                  <p class="font-mono-2xs text-base-dark margin-top-05 margin-bottom-0">{layer.tech}</p>
                </header>
                <div class="usa-card__body">
                  <p class="font-sans-xs text-base-dark margin-0">{layer.desc}</p>
                </div>
                <div class="usa-card__footer">
                  <span class="font-sans-2xs text-bold text-primary">{layer.legal}</span>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</LegalLayout>
