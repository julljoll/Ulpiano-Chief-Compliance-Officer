---
interface Props {
  activePage?: 'index' | 'backend' | 'frontend';
}

const { activePage = 'index' } = Astro.props;
---

<footer class="legal-footer">
  <div class="container-xxl px-3 px-lg-4">
    <!-- 1. HEADER IDENTITY & OPERATIONAL STATUS BAR -->
    <div class="footer-status-bar pb-4 mb-4 border-bottom border-secondary border-opacity-25">
      <div class="row align-items-center gy-3">
        <div class="col-12 col-lg-7">
          <div class="d-flex align-items-center gap-3">
            <div class="footer-seal" aria-hidden="true">
              <span class="seal-icon">⚖️</span>
            </div>
            <div>
              <div class="footer-org-name">
                DIRECCIÓN DE CIBERSEGURIDAD PROCESAL, INFORMÁTICA FORENSE E INTEGRIDAD DIGITAL
              </div>
              <div class="footer-org-sub">
                Órgano Rector de Fe Pública Criptográfica y Supervisión de Sistemas Judiciales •
                República Bolivariana de Venezuela
              </div>
            </div>
          </div>
        </div>
        <div class="col-12 col-lg-5 text-lg-end">
          <div class="footer-status-pill-group">
            <span class="status-indicator-live">
              <span class="status-dot"></span> PRODUCCIÓN V-1.2 AUDITADA
            </span>
            <span class="status-indicator-badge">RANGO ORGÁNICO ART. 203 CRBV</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. MAIN 4-COLUMN TAXONOMIC GRID -->
    <div class="row gy-4 gx-lg-5 footer-main-grid pb-4 mb-4 border-bottom border-secondary border-opacity-25">
      <!-- Col 1: Fundamento Dogmático & Axiomas Romanos -->
      <div class="col-12 col-md-6 col-lg-3">
        <div class="footer-col-header">
          <span class="footer-col-icon material-symbols-outlined">balance</span>
          <span class="footer-col-title">Fundamento Dogmático</span>
        </div>
        <p class="footer-col-desc text-white-50 small mb-3">
          Preceptos del jurista Domicio Ulpiano (<em>Digesto 1.1.10</em>) implementados como reglas
          determinísticas de software:
        </p>
        <div class="footer-axioms-list">
          <div class="footer-axiom-card axiom-honeste">
            <div class="axiom-header">
              <span class="axiom-latin">Honeste Vivere</span>
              <span class="axiom-pill">Integridad</span>
            </div>
            <div class="axiom-meaning">
              Segregación "4 ojos", trazabilidad total e incorruptibilidad funcionarial.
            </div>
          </div>
          <div class="footer-axiom-card axiom-alterum">
            <div class="axiom-header">
              <span class="axiom-latin">Alterum Non Laedere</span>
              <span class="axiom-pill">Inmutabilidad</span>
            </div>
            <div class="axiom-meaning">
              Inmutabilidad probatoria en bóveda WORM y defensa frente al retardo procesal.
            </div>
          </div>
          <div class="footer-axiom-card axiom-suum">
            <div class="axiom-header">
              <span class="axiom-latin">Suum Cuique Tribuere</span>
              <span class="axiom-pill">Equidad</span>
            </div>
            <div class="axiom-meaning">
              Sorteo aleatorio criptoseguro (CSPRNG) e imparcialidad matemática en causas.
            </div>
          </div>
        </div>
      </div>

      <!-- Col 2: Módulos del Portal (SPA) -->
      <div class="col-12 col-md-6 col-lg-3">
        <div class="footer-col-header">
          <span class="footer-col-icon material-symbols-outlined">dashboard</span>
          <span class="footer-col-title">Módulos del Sistema</span>
        </div>
        <ul class="footer-nav-list list-unstyled mb-0">
          <li>
            <a
              href="index.html#dashboard"
              class="footer-nav-link"
              data-view-target="dashboard"
              onclick="if(window.UlpianoDash){window.UlpianoDash.switchView('dashboard');return false;}"
            >
              <span class="footer-link-dot"></span>
              <span>Dashboard de Control V-1.2</span>
              <span class="badge bg-secondary bg-opacity-50 text-white-50 ms-auto">KPI</span>
            </a>
          </li>
          <li>
            <a
              href="index.html#diagrams"
              class="footer-nav-link"
              data-view-target="diagrams"
              onclick="if(window.UlpianoDash){window.UlpianoDash.switchView('diagrams');return false;}"
            >
              <span class="footer-link-dot"></span>
              <span>Suite de Diagramas (9 Vistas)</span>
              <span class="badge bg-primary bg-opacity-25 text-info ms-auto">SVG</span>
            </a>
          </li>
          <li>
            <a
              href="index.html#api"
              class="footer-nav-link"
              data-view-target="api"
              onclick="if(window.UlpianoDash){window.UlpianoDash.switchView('api');return false;}"
            >
              <span class="footer-link-dot"></span>
              <span>Consola API &amp; WebSockets</span>
              <span class="badge bg-success bg-opacity-25 text-success ms-auto">FASTAPI</span>
            </a>
          </li>
          <li>
            <a
              href="index.html#reader"
              class="footer-nav-link"
              data-view-target="reader"
              onclick="if(window.UlpianoDash){window.UlpianoDash.switchView('reader');return false;}"
            >
              <span class="footer-link-dot"></span>
              <span>Lector Normativo Oficial</span>
              <span class="badge bg-secondary bg-opacity-50 text-white-50 ms-auto">GACETA</span>
            </a>
          </li>
          <li>
            <a
              href="index.html#compare"
              class="footer-nav-link"
              data-view-target="compare"
              onclick="if(window.UlpianoDash){window.UlpianoDash.switchView('compare');return false;}"
            >
              <span class="footer-link-dot"></span>
              <span>Comparador Diferencial</span>
              <span class="badge bg-danger bg-opacity-25 text-danger ms-auto">DIFF</span>
            </a>
          </li>
          <li>
            <a
              href="index.html#matrix"
              class="footer-nav-link"
              data-view-target="matrix"
              onclick="if(window.UlpianoDash){window.UlpianoDash.switchView('matrix');return false;}"
            >
              <span class="footer-link-dot"></span>
              <span>Matriz de Trazabilidad ISO</span>
              <span class="badge bg-warning bg-opacity-25 text-warning ms-auto">AUDIT</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Arquitectura Técnica & Ecosistema -->
      <div class="col-12 col-md-6 col-lg-3">
        <div class="footer-col-header">
          <span class="footer-col-icon material-symbols-outlined">terminal</span>
          <span class="footer-col-title">Arquitectura Técnica</span>
        </div>
        <ul class="footer-nav-list list-unstyled mb-0">
          <li>
            <a
              href="backend.html"
              class={`footer-nav-link ${activePage === 'backend' ? 'active-link' : ''}`}
            >
              <span class="footer-link-dot"></span>
              <span>Servidor API Python 3.12</span>
              <span class="badge bg-primary bg-opacity-50 text-white ms-auto">FastAPI</span>
            </a>
          </li>
          <li>
            <a
              href="frontend.html"
              class={`footer-nav-link ${activePage === 'frontend' ? 'active-link' : ''}`}
            >
              <span class="footer-link-dot"></span>
              <span>Cliente Web Next.js 15</span>
              <span class="badge bg-dark border border-secondary text-white-50 ms-auto">
                React 19
              </span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/julljoll/Ulpiano-Chief-Compliance-Officer"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-nav-link"
            >
              <span class="footer-link-dot"></span>
              <span>Repositorio en GitHub</span>
              <span
                class="material-symbols-outlined ms-auto text-white-50"
                style="font-size: 0.95rem;"
              >
                open_in_new
              </span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/julljoll/Ulpiano-Chief-Compliance-Officer/blob/main/openapi.json"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-nav-link"
            >
              <span class="footer-link-dot"></span>
              <span>Especificación OpenAPI 3.1</span>
              <span class="badge bg-secondary bg-opacity-25 text-white-50 ms-auto">REST/WSS</span>
            </a>
          </li>
          <li>
            <a
              href="svg/ciberseguridad_integracion_V1.2.svg"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-nav-link"
            >
              <span class="footer-link-dot"></span>
              <span>Diagrama Maestro Vectorial</span>
              <span class="badge bg-info bg-opacity-25 text-info ms-auto">SVG</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Bloque Constitucional & Estándares -->
      <div class="col-12 col-md-6 col-lg-3">
        <div class="footer-col-header">
          <span class="footer-col-icon material-symbols-outlined">policy</span>
          <span class="footer-col-title">Bloque Normativo</span>
        </div>
        <p class="footer-col-desc text-white-50 small mb-2">
          Garantías jurídicas vinculadas por reserva legal:
        </p>
        <div class="footer-legal-tags">
          <div class="footer-legal-tag">
            <span class="tag-title">CRBV Art. 203</span>
            <span class="tag-desc">Reserva de Ley Orgánica</span>
          </div>
          <div class="footer-legal-tag">
            <span class="tag-title">TSJ/SC N° 0406/2026</span>
            <span class="tag-desc">Precedente de Rango Orgánico</span>
          </div>
          <div class="footer-legal-tag">
            <span class="tag-title">LOCOTA 2026</span>
            <span class="tag-desc">Título VII: Ciberseguridad</span>
          </div>
          <div class="footer-legal-tag">
            <span class="tag-title">LMDyFE &amp; Infogobierno</span>
            <span class="tag-desc">Firma Electrónica SUSCERTE</span>
          </div>
          <div class="footer-legal-tag">
            <span class="tag-title">FISMA 2014 &amp; NIST 800-53</span>
            <span class="tag-desc">Alta Disponibilidad &amp; Control</span>
          </div>
          <div class="footer-legal-tag">
            <span class="tag-title">ISO 27001 · 27037 · 42001</span>
            <span class="tag-desc">Seguridad, Forense e IA Ética</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. TRUST & CRYPTOGRAPHIC CERTIFICATION RIBBON -->
    <div class="footer-trust-ribbon py-3 px-3 mb-4 rounded bg-dark bg-opacity-50 border border-secondary border-opacity-25">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 text-white-50 small">
        <div class="d-flex align-items-center gap-2">
          <span class="material-symbols-outlined text-warning" style="font-size: 1.2rem;">
            verified
          </span>
          <span class="fw-semibold text-white">
            Garantías de Confianza Criptográfica y Accesibilidad:
          </span>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3">
          <span class="trust-badge">
            <span class="trust-badge-icon">🔒</span> TLS 1.3 / HSTS 4096-bit
          </span>
          <span class="trust-badge">
            <span class="trust-badge-icon">🔏</span> Firma SUSCERTE / TSA RFC 3161
          </span>
          <span class="trust-badge">
            <span class="trust-badge-icon">🛡️</span> Bóveda WORM MinIO Object Lock
          </span>
          <span class="trust-badge">
            <span class="trust-badge-icon">⚖️</span> FIPS 140-2 Level 3 HSM
          </span>
          <span class="trust-badge">
            <span class="trust-badge-icon">🌐</span> WCAG 2.1 AAA &amp; Section 508
          </span>
        </div>
      </div>
    </div>

    <!-- 4. INSTITUTIONAL BOTTOM SUB-BAR -->
    <div class="footer-bottom-bar pt-2">
      <div class="row align-items-center gy-3">
        <div class="col-12 col-lg-8">
          <div class="footer-copyright text-white-50 small">
            © 2026 <strong>Ulpiano — Chief Compliance Officer</strong>. Desarrollado por{' '}
            <strong>Jull Ortiz</strong> (
            <a
              href="https://sha256.us"
              target="_blank"
              rel="noopener noreferrer"
              class="text-info text-decoration-none"
            >
              sha256.us
            </a>
            ). Licencia de Código Abierto <strong>Apache 2.0</strong>.
          </div>
          <div class="footer-disclaimer text-secondary small mt-1">
            Portal institucional de demostración técnica, trazabilidad dogmática y auditoría
            procesal continua. Conforme al principio de máxima publicidad y debido proceso judicial
            (Arts. 26 y 49 CRBV).
          </div>
        </div>
        <div class="col-12 col-lg-4 text-lg-end">
          <div class="footer-meta-links d-flex flex-wrap justify-content-lg-end gap-3 text-secondary small">
            <a
              href="https://github.com/julljoll/Ulpiano-Chief-Compliance-Officer/blob/main/LICENSE"
              target="_blank"
              rel="noopener noreferrer"
            >
              Licencia Apache 2.0
            </a>
            <span>•</span>
            <a
              href="https://github.com/julljoll/Ulpiano-Chief-Compliance-Officer/security"
              target="_blank"
              rel="noopener noreferrer"
            >
              Seguridad &amp; Vulnerabilidades
            </a>
            <span>•</span>
            <a href="index.html#matrix">Trazabilidad ISO</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
