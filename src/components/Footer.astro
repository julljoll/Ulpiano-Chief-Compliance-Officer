---
/**
 * USWDS Component: Footer (Big)
 * Fuente oficial: https://designsystem.digital.gov/components/footer/
 */
interface Props {
  activePage?: 'index' | 'backend' | 'frontend';
}

const { activePage = 'index' } = Astro.props;
---

<footer class="usa-footer usa-footer--big">
  <div class="grid-container usa-footer__return-to-top">
    <a href="#">Volver arriba</a>
  </div>
  <div class="usa-footer__primary-section">
    <div class="grid-container">
      <div class="grid-row grid-gap">
        <div class="tablet:grid-col-8">
          <nav class="usa-footer__nav" aria-label="Navegación del pie de página">
            <div class="grid-row grid-gap-4">
              <div class="mobile-lg:grid-col-6 desktop:grid-col-4">
                <section class="usa-footer__primary-content usa-footer__primary-content--collapsible">
                  <h4 class="usa-footer__primary-link">Fundamento Dogmático</h4>
                  <ul class="usa-list usa-list--unstyled">
                    <li class="usa-footer__secondary-link">
                      <em>Honeste Vivere</em> (Integridad &amp; 4 Ojos)
                    </li>
                    <li class="usa-footer__secondary-link">
                      <em>Alterum Non Laedere</em> (Inmutabilidad WORM)
                    </li>
                    <li class="usa-footer__secondary-link">
                      <em>Suum Cuique Tribuere</em> (Sorteo CSPRNG)
                    </li>
                  </ul>
                </section>
              </div>
              <div class="mobile-lg:grid-col-6 desktop:grid-col-4">
                <section class="usa-footer__primary-content usa-footer__primary-content--collapsible">
                  <h4 class="usa-footer__primary-link">Módulos del Sistema</h4>
                  <ul class="usa-list usa-list--unstyled">
                    <li class="usa-footer__secondary-link">
                      <a href="index.html#dashboard">Dashboard de Control V-1.2</a>
                    </li>
                    <li class="usa-footer__secondary-link">
                      <a href="index.html#diagrams">Suite de Diagramas (9 Vistas)</a>
                    </li>
                    <li class="usa-footer__secondary-link">
                      <a href="index.html#api">Consola API &amp; WSS</a>
                    </li>
                    <li class="usa-footer__secondary-link">
                      <a href="index.html#reader">Lector Normativo</a>
                    </li>
                    <li class="usa-footer__secondary-link">
                      <a href="index.html#compare">Comparador Diferencial</a>
                    </li>
                    <li class="usa-footer__secondary-link">
                      <a href="index.html#matrix">Matriz de Trazabilidad</a>
                    </li>
                  </ul>
                </section>
              </div>
              <div class="mobile-lg:grid-col-6 desktop:grid-col-4">
                <section class="usa-footer__primary-content usa-footer__primary-content--collapsible">
                  <h4 class="usa-footer__primary-link">Arquitectura Técnica</h4>
                  <ul class="usa-list usa-list--unstyled">
                    <li class="usa-footer__secondary-link">
                      <a href="backend.html" class={activePage === 'backend' ? 'usa-current' : ''}>
                        Servidor API Python 3.12
                      </a>
                    </li>
                    <li class="usa-footer__secondary-link">
                      <a
                        href="frontend.html"
                        class={activePage === 'frontend' ? 'usa-current' : ''}
                      >
                        Cliente Web Next.js 15
                      </a>
                    </li>
                    <li class="usa-footer__secondary-link">
                      <a
                        href="https://github.com/julljoll/Ulpiano-Chief-Compliance-Officer"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Repositorio en GitHub
                      </a>
                    </li>
                    <li class="usa-footer__secondary-link">
                      <a
                        href="https://github.com/julljoll/Ulpiano-Chief-Compliance-Officer/blob/main/openapi.json"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Especificación OpenAPI 3.1
                      </a>
                    </li>
                  </ul>
                </section>
              </div>
            </div>
          </nav>
        </div>
        <div class="tablet:grid-col-4">
          <div class="usa-sign-up">
            <h4 class="usa-sign-up__heading">Garantías Criptográficas</h4>
            <p class="usa-sign-up__text">
              Conforme al Art. 203 CRBV, Sentencia TSJ/SC N° 0406/2026, FISMA 2014, LOCOTA 2026 e
              ISO/IEC 27001 / 27037 / 42001. Bóveda WORM MinIO Object Lock y sellado de tiempo RFC
              3161.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="usa-footer__secondary-section">
    <div class="grid-container">
      <div class="grid-row grid-gap">
        <div class="usa-footer__logo grid-row mobile-lg:grid-col-6 mobile-lg:grid-gap-2">
          <div class="mobile-lg:grid-col-auto">
            <p class="usa-footer__logo-heading">Ulpiano — Chief Compliance Officer</p>
            <p class="font-sans-2xs text-base-light margin-top-05">
              Dirección de Ciberseguridad Procesal, Informática Forense e Integridad Digital. Autor:
              Jull Ortiz (sha256.us). Licencia Apache 2.0.
            </p>
          </div>
        </div>
        <div class="usa-footer__contact-links mobile-lg:grid-col-6">
          <p class="usa-footer__contact-heading">Contacto Institucional</p>
          <address class="usa-footer__address">
            <div class="usa-footer__contact-info grid-row grid-gap">
              <div class="grid-col-auto">
                <a href="https://sha256.us" target="_blank" rel="noopener noreferrer">
                  sha256.us
                </a>
              </div>
              <div class="grid-col-auto">
                <a
                  href="https://github.com/julljoll/Ulpiano-Chief-Compliance-Officer"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  GitHub Oficial
                </a>
              </div>
            </div>
          </address>
        </div>
      </div>
    </div>
  </div>
</footer>
