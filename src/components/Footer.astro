---
/**
 * USWDS Component: Footer (Big) — Light-Only Institutional Multi-Page Footer
 */
import Icon from './Icon.astro';

interface Props {
  activeSection?: string;
}

const { activeSection = 'dashboard' } = Astro.props;
---

<footer class="usa-footer usa-footer--big">
  <div class="grid-container usa-footer__return-to-top">
    <a href="#main-content" class="ulp-btn-icon text-no-underline font-sans-xs text-bold">
      <Icon name="keyboard_arrow_up" size={16} />
      <span>Volver arriba</span>
    </a>
  </div>
  <div class="usa-footer__primary-section">
    <div class="grid-container">
      <div class="grid-row grid-gap">
        <div class="tablet:grid-col-8">
          <nav class="usa-footer__nav" aria-label="Navegación del pie de página">
            <div class="grid-row grid-gap">
              <div class="mobile-lg:grid-col-6 desktop:grid-col-4">
                <section class="usa-footer__primary-content">
                  <h2 class="usa-footer__primary-link">Fundamento Dogmático</h2>
                  <ul class="usa-list usa-list--unstyled">
                    <li class="usa-footer__secondary-link">
                      <a href="/lector/v1.2/#articulo-27">
                        <em>Honeste Vivere</em> (Integridad &amp; 4 Ojos)
                      </a>
                    </li>
                    <li class="usa-footer__secondary-link">
                      <a href="/lector/v1.2/#articulo-28">
                        <em>Alterum Non Laedere</em> (Inmutabilidad WORM)
                      </a>
                    </li>
                    <li class="usa-footer__secondary-link">
                      <a href="/lector/v1.2/#articulo-26">
                        <em>Suum Cuique Tribuere</em> (Sorteo CSPRNG)
                      </a>
                    </li>
                  </ul>
                </section>
              </div>
              <div class="mobile-lg:grid-col-6 desktop:grid-col-4">
                <section class="usa-footer__primary-content">
                  <h2 class="usa-footer__primary-link">Módulos del Sistema</h2>
                  <ul class="usa-list usa-list--unstyled">
                    <li class="usa-footer__secondary-link">
                      <a href="/">Dashboard de Control V-1.2</a>
                    </li>
                    <li class="usa-footer__secondary-link">
                      <a href="/lector/v1.2/">Lector Normativo &amp; RAG</a>
                    </li>
                    <li class="usa-footer__secondary-link">
                      <a href="/comparador/v1.0-vs-v1.2/">Comparador Diferencial</a>
                    </li>
                    <li class="usa-footer__secondary-link">
                      <a href="/diagramas/master/">Suite de Diagramas (12 Vistas)</a>
                    </li>
                    <li class="usa-footer__secondary-link">
                      <a href="/matriz/">Matriz de Trazabilidad</a>
                    </li>
                    <li class="usa-footer__secondary-link">
                      <a href="/consola-api/">Consola API &amp; WSS</a>
                    </li>
                  </ul>
                </section>
              </div>
              <div class="mobile-lg:grid-col-6 desktop:grid-col-4">
                <section class="usa-footer__primary-content">
                  <h2 class="usa-footer__primary-link">Arquitectura Técnica</h2>
                  <ul class="usa-list usa-list--unstyled">
                    <li class="usa-footer__secondary-link">
                      <a href="/backend/" class={activeSection === 'backend' ? 'usa-current' : ''}>
                        Servidor API Python 3.12
                      </a>
                    </li>
                    <li class="usa-footer__secondary-link">
                      <a href="/frontend/" class={activeSection === 'frontend' ? 'usa-current' : ''}>
                        Cliente Web Next.js 15
                      </a>
                    </li>
                    <li class="usa-footer__secondary-link">
                      <a
                        href="https://github.com/julljoll/Ulpiano-Chief-Compliance-Officer"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Repositorio en GitHub
                      </a>
                    </li>
                    <li class="usa-footer__secondary-link">
                      <a href="/openapi.json" target="_blank" rel="noopener noreferrer">
                        Especificación OpenAPI 3.1
                      </a>
                    </li>
                  </ul>
                </section>
              </div>
            </div>
          </nav>
        </div>
        <div class="tablet:grid-col-4">
          <div class="usa-sign-up">
            <h2 class="usa-sign-up__heading">Garantías Criptográficas</h2>
            <p class="usa-sign-up__text">
              Conforme al Art. 203 CRBV, Sentencia TSJ/SC N° 0406/2026, FISMA 2014, LOCOTA 2026 e
              ISO/IEC 27001 / 27037 / 42001. Bóveda WORM MinIO Object Lock y sellado de tiempo RFC
              3161.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="usa-footer__secondary-section">
    <div class="grid-container">
      <div class="grid-row grid-gap flex-align-center">
        <div class="usa-footer__logo grid-row mobile-lg:grid-col-7 mobile-lg:grid-gap-2 flex-align-center">
          <div class="grid-col-auto">
            <span class="ulp-brand__emblem" aria-hidden="true">
              <Icon name="balance" size={20} />
            </span>
          </div>
          <div class="grid-col-fill">
            <p class="usa-footer__logo-heading margin-0">Ulpiano — Chief Compliance Officer</p>
            <p class="font-sans-2xs text-base-darker margin-top-05 margin-bottom-0">
              Dirección de Ciberseguridad Procesal, Informática Forense e Integridad Digital. Autor:
              Jull Ortiz (sha256.us). Licencia Apache 2.0.
            </p>
          </div>
        </div>
        <div class="usa-footer__contact-links mobile-lg:grid-col-5">
          <p class="usa-footer__contact-heading">Contacto Institucional</p>
          <address class="usa-footer__address">
            <div class="usa-footer__contact-info grid-row grid-gap">
              <div class="grid-col-auto">
                <a href="https://sha256.us" target="_blank" rel="noopener noreferrer">
                  sha256.us
                </a>
              </div>
              <div class="grid-col-auto">
                <a
                  href="https://github.com/julljoll/Ulpiano-Chief-Compliance-Officer"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  GitHub Oficial
                </a>
              </div>
            </div>
          </address>
        </div>
      </div>
    </div>
  </div>
</footer>
