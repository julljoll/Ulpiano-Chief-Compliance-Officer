---
/**
 * USWDS Component: Identifier — Zero-JS Multi-Page Links
 */
---

<div class="usa-identifier">
  <section
    class="usa-identifier__section usa-identifier__section--masthead"
    aria-label="Identificador institucional"
  >
    <div class="usa-identifier__container">
      <section
        class="usa-identifier__identity"
        aria-label="Dirección de Ciberseguridad Procesal e Integridad Digital"
      >
        <p class="usa-identifier__identity-domain">ulpiano.sha256.us</p>
        <p class="usa-identifier__identity-disclaimer">
          Un portal oficial de la Dirección de Ciberseguridad Procesal, Informática Forense e
          Integridad Digital para la modernización de los sistemas judiciales. Rango Orgánico (Art.
          203 CRBV / Sentencia TSJ Sala Constitucional N° 0406/2026).
        </p>
      </section>
    </div>
  </section>
  <nav
    class="usa-identifier__section usa-identifier__section--required-links"
    aria-label="Enlaces institucionales importantes"
  >
    <div class="usa-identifier__container">
      <ul class="usa-identifier__required-links-list">
        <li class="usa-identifier__required-links-item">
          <a
            href="https://github.com/julljoll/Ulpiano-Chief-Compliance-Officer"
            class="usa-identifier__required-link usa-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            Código Fuente en GitHub
          </a>
        </li>
        <li class="usa-identifier__required-links-item">
          <a
            href="https://github.com/julljoll/Ulpiano-Chief-Compliance-Officer/blob/main/LICENSE"
            class="usa-identifier__required-link usa-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            Licencia Apache 2.0
          </a>
        </li>
        <li class="usa-identifier__required-links-item">
          <a
            href="/openapi.json"
            class="usa-identifier__required-link usa-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            OpenAPI 3.1 (JSON)
          </a>
        </li>
        <li class="usa-identifier__required-links-item">
          <a href="/matriz/" class="usa-identifier__required-link usa-link">
            Trazabilidad de Normas ISO / FISMA
          </a>
        </li>
      </ul>
    </div>
  </nav>
</div>
