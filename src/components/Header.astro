---
/**
 * ULPIANO CCO — Institutional Extended Header (USWDS 3.0 Light-Only)
 * Zero wrapped nav items on desktop, 1-line emblem brand, Command Bar trigger,
 * build-time aria-current="page", and lightweight accessible mobile drawer.
 */
import Icon, { type IconName } from './Icon.astro';

interface Props {
  activeSection?:
    | 'dashboard'
    | 'diagrams'
    | 'api'
    | 'reader'
    | 'compare'
    | 'matrix'
    | 'backend'
    | 'frontend';
}

const { activeSection = 'dashboard' } = Astro.props;

interface NavItem {
  id: string;
  label: string;
  href: string;
  icon: IconName;
  matches: string[];
}

const navItems: NavItem[] = [
  { id: 'dashboard', label: 'Inicio', href: '/', icon: 'balance', matches: ['dashboard'] },
  {
    id: 'reader',
    label: 'Lector Normativo',
    href: '/lector/v1.2/',
    icon: 'menu_book',
    matches: ['reader'],
  },
  {
    id: 'compare',
    label: 'Comparador',
    href: '/comparador/v1.0-vs-v1.2/',
    icon: 'compare_arrows',
    matches: ['compare'],
  },
  {
    id: 'diagrams',
    label: 'Diagramas',
    href: '/diagramas/master/',
    icon: 'account_tree',
    matches: ['diagrams'],
  },
  {
    id: 'matrix',
    label: 'Matriz ISO',
    href: '/matriz/',
    icon: 'table_chart',
    matches: ['matrix'],
  },
  {
    id: 'api',
    label: 'Consola API',
    href: '/consola-api/',
    icon: 'terminal',
    matches: ['api'],
  },
  {
    id: 'architecture',
    label: 'Arquitectura',
    href: '/backend/',
    icon: 'architecture',
    matches: ['backend', 'frontend'],
  },
];
---

<div class="ulp-top-strip ulp-no-print" role="region" aria-label="Información institucional">
  <div class="grid-container">
    <div class="ulp-top-strip__inner">
      <span class="ulp-top-strip__label">
        <Icon name="verified_user" size={14} />
        <span>Portal Técnico-Jurídico de Ciberseguridad Procesal e Integridad Digital</span>
      </span>
      <span class="ulp-top-strip__meta">
        Ley Orgánica Art. 203 CRBV · TSJ/SC 0406/2026 · V-1.2
      </span>
    </div>
  </div>
</div>

<header class="ulp-header">
  <div class="ulp-header__top">
    <div class="grid-container">
      <div class="ulp-header__bar">
        <a href="/" class="ulp-brand" title="Inicio — Ulpiano Chief Compliance Officer">
          <span class="ulp-brand__emblem" aria-hidden="true">
            <Icon name="balance" size={20} />
          </span>
          <span class="ulp-brand__text">
            <span class="ulp-brand__title">Ulpiano CCO</span>
            <span class="ulp-brand__subtitle">
              Dirección de Ciberseguridad Procesal &amp; Compliance
            </span>
          </span>
        </a>

        <div class="ulp-header__utilities">
          <button
            type="button"
            id="btn-open-global-search"
            class="ulp-search-trigger"
            data-open-search
            title="Abrir búsqueda global (Ctrl+K)"
          >
            <span class="ulp-search-trigger__left">
              <Icon name="search" size={16} />
              <span class="ulp-search-trigger__label">Buscar artículos, normas...</span>
            </span>
            <kbd class="ulp-kbd">Ctrl K</kbd>
          </button>

          <button
            type="button"
            class="ulp-header__menu-btn"
            data-nav-open
            aria-expanded="false"
            aria-controls="primary-nav-drawer"
          >
            <Icon name="menu" size={18} />
            <span>Menú</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <nav
    id="primary-nav-drawer"
    aria-label="Navegación principal"
    class="ulp-nav-bar"
    data-nav-drawer
  >
    <div class="grid-container">
      <div class="ulp-nav-drawer__header">
        <span class="font-sans-sm text-bold text-primary-darker">Navegación</span>
        <button
          type="button"
          class="usa-button usa-button--outline usa-button--small ulp-btn-icon"
          data-nav-close
          aria-label="Cerrar menú de navegación"
        >
          <Icon name="close" size={16} />
          <span>Cerrar</span>
        </button>
      </div>

      <div class="ulp-nav-drawer__search">
        <button
          type="button"
          class="usa-button usa-button--outline width-full ulp-btn-icon"
          data-open-search
        >
          <Icon name="search" size={16} />
          <span>Búsqueda Global (Ctrl+K)</span>
        </button>
      </div>

      <ul class="ulp-nav-list">
        {navItems.map((item) => {
          const isCurrent = item.matches.includes(activeSection);
          return (
            <li class="ulp-nav-item">
              <a
                href={item.href}
                class={`ulp-nav-link ${isCurrent ? 'usa-current' : ''}`}
                aria-current={isCurrent ? 'page' : undefined}
              >
                <Icon name={item.icon} size={16} />
                <span>{item.label}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </nav>
</header>

<script>
  const openBtn = document.querySelector<HTMLButtonElement>('[data-nav-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-nav-close]');
  const drawer = document.querySelector<HTMLElement>('[data-nav-drawer]');
  const overlay = document.querySelector<HTMLElement>('[data-nav-overlay]');

  const setOpen = (open: boolean) => {
    drawer?.classList.toggle('is-visible', open);
    overlay?.classList.toggle('is-visible', open);
    openBtn?.setAttribute('aria-expanded', String(open));
    if (open) closeBtn?.focus();
    else openBtn?.focus();
  };

  openBtn?.addEventListener('click', () => setOpen(true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  overlay?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('is-visible')) setOpen(false);
  });
</script>
