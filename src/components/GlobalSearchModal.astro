---
/**
 * ULPIANO CCO — Lazy Global Command Palette Search Dialog (Ctrl+K)
 * Fetches static build-time `/search-index.json` ONLY on first open (0 bytes on initial page load).
 * Full keyboard navigation (ArrowUp/ArrowDown/Enter/Escape).
 */
import Icon from './Icon.astro';
---

<dialog
  id="global-search-dialog"
  class="ulp-search-dialog"
  aria-labelledby="global-search-heading"
>
  <h2 id="global-search-heading" class="usa-sr-only">
    Búsqueda Global Ulpiano CCO
  </h2>

  <div class="ulp-search-dialog__head">
    <Icon name="search" size={20} class="text-primary" />
    <label class="usa-sr-only" for="global-search-input">
      Buscar artículos, reformas V-1.2, matriz ISO/FISMA, Catálogo RAG o los 12 diagramas
    </label>
    <input
      id="global-search-input"
      class="ulp-search-dialog__input"
      type="search"
      placeholder="Buscar artículos (ej. 10-bis, 19-bis), FISMA, WORM, LOCOTA, FastAPI..."
      autocomplete="off"
    />
    <button
      type="button"
      class="usa-button usa-button--outline usa-button--small ulp-btn-icon"
      data-close-search
      aria-label="Cerrar búsqueda global (Esc)"
    >
      <Icon name="close" size={14} />
      <span>Cerrar</span>
    </button>
  </div>

  <div
    id="global-search-results"
    class="ulp-search-results"
    role="region"
    aria-label="Resultados de búsqueda"
    tabindex="0"
  ></div>

  <div class="ulp-search-dialog__foot">
    <span id="global-search-count" aria-live="polite">0 resultados</span>
    <span class="display-flex flex-align-center ulp-gap-1">
      <kbd class="ulp-kbd">↑</kbd>
      <kbd class="ulp-kbd">↓</kbd>
      <span>navegar</span>
      <kbd class="ulp-kbd">Enter</kbd>
      <span>abrir</span>
      <kbd class="ulp-kbd">Ctrl K</kbd>
      <span>buscar</span>
    </span>
  </div>
</dialog>

<script>
  import { escapeHtml } from '../lib/format.ts';

  interface SearchEntry {
    kind: string;
    title: string;
    subtitle: string;
    href: string;
  }

  const dialog = document.getElementById('global-search-dialog') as HTMLDialogElement | null;
  const input = document.getElementById('global-search-input') as HTMLInputElement | null;
  const resultsEl = document.getElementById('global-search-results');
  const countEl = document.getElementById('global-search-count');

  let indexCache: SearchEntry[] | null = null;
  let activeIndex = -1;

  const normalize = (s: string) =>
    s
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');

  const kindTagClass = (kind: string): string => {
    const k = kind.toLowerCase();
    if (k.includes('reforma') || k.includes('artículo')) return 'usa-tag ulp-tag-v12';
    if (k.includes('diagrama')) return 'usa-tag ulp-tag-forensic';
    if (k.includes('matriz')) return 'usa-tag ulp-tag-success';
    return 'usa-tag';
  };

  async function ensureIndex(): Promise<SearchEntry[]> {
    if (indexCache) return indexCache;
    try {
      const res = await fetch('/search-index.json');
      if (res.ok) {
        indexCache = (await res.json()) as SearchEntry[];
        return indexCache;
      }
    } catch {
      // Offline / network fallback
    }
    return [];
  }

  function updateSelection(newIdx: number): void {
    if (!resultsEl) return;
    const buttons = resultsEl.querySelectorAll<HTMLAnchorElement>('.ulp-search-result-btn');
    if (buttons.length === 0) {
      activeIndex = -1;
      return;
    }
    activeIndex = (newIdx + buttons.length) % buttons.length;
    buttons.forEach((b, i) => b.classList.toggle('is-selected', i === activeIndex));
    buttons[activeIndex]?.scrollIntoView({ block: 'nearest' });
  }

  function renderResults(entries: SearchEntry[], rawQuery: string): void {
    if (!resultsEl || !countEl) return;
    const q = normalize(rawQuery.trim());
    const matches = !q
      ? entries.slice(0, 10)
      : entries
          .filter((e) => normalize(`${e.kind} ${e.title} ${e.subtitle}`).includes(q))
          .slice(0, 24);

    activeIndex = matches.length > 0 ? 0 : -1;
    countEl.textContent =
      matches.length === 1
        ? '1 resultado encontrado'
        : `${matches.length} resultados mostrados`;

    if (matches.length === 0) {
      resultsEl.innerHTML =
        '<p class="font-sans-xs text-base-dark margin-y-2 text-center">Sin coincidencias. Intente con «10-bis», «19-bis», «FISMA», «WORM», «LOCOTA» o «FastAPI».</p>';
      return;
    }

    resultsEl.innerHTML = matches
      .map(
        (m, idx) => `
      <a class="ulp-search-result-btn text-no-underline ${idx === 0 ? 'is-selected' : ''}" href="${escapeHtml(m.href)}">
        <div>
          <div class="font-sans-sm text-bold text-ink">${escapeHtml(m.title)}</div>
          <div class="font-sans-2xs text-base-dark margin-top-05">${escapeHtml(m.subtitle)}</div>
        </div>
        <span class="${kindTagClass(m.kind)} flex-align-self-center">${escapeHtml(m.kind)}</span>
      </a>`
      )
      .join('');
  }

  async function openDialog(): Promise<void> {
    if (!dialog) return;
    if (!dialog.open) dialog.showModal();
    if (countEl) countEl.textContent = 'Cargando índice normativo...';
    const entries = await ensureIndex();
    renderResults(entries, input?.value || '');
    input?.focus();
    input?.select();
  }

  function closeDialog(): void {
    if (dialog?.open) dialog.close();
  }

  document.querySelectorAll('[data-open-search]').forEach((btn) => {
    btn.addEventListener('click', () => {
      void openDialog();
    });
  });

  document.querySelectorAll('[data-close-search]').forEach((btn) => {
    btn.addEventListener('click', closeDialog);
  });

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) closeDialog();
  });

  input?.addEventListener('input', async () => {
    const entries = await ensureIndex();
    renderResults(entries, input.value);
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      updateSelection(activeIndex + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      updateSelection(activeIndex - 1);
    } else if (e.key === 'Enter' && activeIndex >= 0 && resultsEl) {
      const selected = resultsEl.querySelectorAll<HTMLAnchorElement>('.ulp-search-result-btn')[
        activeIndex
      ];
      if (selected) {
        e.preventDefault();
        window.location.href = selected.href;
      }
    }
  });

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (dialog?.open) closeDialog();
      else void openDialog();
    }
  });
</script>
