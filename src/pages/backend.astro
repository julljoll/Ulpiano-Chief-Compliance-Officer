---
import ArchitecturePage from '../components/ArchitecturePage.astro';
import type { ArchLayerItem } from '../types/legal.ts';

const layers: ArchLayerItem[] = [
  {
    badge: 'Capa 1: Ingress',
    title: 'Ingress API & Autenticación',
    tech: 'uvicorn / uvloop',
    desc: 'FastAPI ASGI de alto rendimiento, terminación TLS 1.3, autenticación OAuth2 + JWT (FIDO2) y limitación estricta de tasa por IP.',
    legal: 'LPCDI Art. 9 • ISO/IEC 27001',
  },
  {
    badge: 'Capa 2: Lógica Forense',
    title: 'Firma & Sorteo Criptoseguro',
    tech: 'PyKCS11 + pyHanko',
    desc: 'Firma PAdES-B-LTA con token HSM PKCS#11 FIPS 140-2 L3, sellado TSA RFC 3161 y sorteo aleatorio imparcial con CSPRNG.',
    legal: 'LMDyFE Arts. 4, 6, 8 • Art. 26',
  },
  {
    badge: 'Capa 3: Asíncrona',
    title: 'Colas & IA Ética (ISO 42001)',
    tech: 'Celery + Redis 7',
    desc: 'Workers en Celery para análisis de resoluciones, motor RAG sobre PostgreSQL pgvector y alertas tempranas hacia la Contraloría.',
    legal: 'LOCOTA Art. 11 • ISO/IEC 42001',
  },
  {
    badge: 'Capa 4: Persistencia',
    title: 'Bóveda WORM & Árbol Merkle',
    tech: 'PostgreSQL + MinIO WORM',
    desc: 'Almacenamiento inmutable S3 Object Lock (WORM) con hash dual SHA-256/SHA3-512 y bitácora forense verificable.',
    legal: 'Infogobierno Art. 27 • Art. 28',
  },
];
---

<ArchitecturePage
  pageTitle="Arquitectura Backend Python 3.12 (FastAPI) | Ulpiano Chief Compliance Officer"
  pageDescription="Diagrama y especificación técnica de la arquitectura de servidor API en Python 3.12 (FastAPI, PyKCS11 HSM, Celery, PostgreSQL 16 pgvector y MinIO S3 WORM) para el sistema judicial."
  activeSection="backend"
  heroLabel="Arquitectura Backend"
  breadcrumbCurrent="Servidor API Python 3.12 (FastAPI)"
  heroTag="PYTHON 3.12 CORE • FASTAPI + UVLOOP • OPENAPI 3.1"
  heroHeading="Arquitectura del Servidor API Backend en Python 3.12"
  heroIntro="Diagrama técnico y flujo de datos del núcleo de procesamiento judicial: gestión asíncrona, firma criptográfica SUSCERTE con PyKCS11, tareas de fondo Celery/Redis, persistencia pgvector y bóveda inmutable WORM conforme a la LMDyFE y la Ley de Infogobierno."
  svgPath="/svg/backend_python_api_arquitectura.svg"
  svgDownloadName="backend_python_api_arquitectura.svg"
  svgAlt="Diagrama de Arquitectura Backend Python 3.12 FastAPI"
  viewerTag="BACKEND CORE"
  viewerHeading="Diagrama Oficial de Arquitectura Backend (Python 3.12 FastAPI)"
  siblingHref="/frontend/"
  siblingLabel="Ver Arquitectura Frontend Next.js"
  layersHeading="Desglose por Capas de la Arquitectura Backend"
  layers={layers}
/>
