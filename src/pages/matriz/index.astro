---
/**
 * ULPIANO CCO — Normative Traceability Matrix Page (/matriz/)
 * Compact header, unified segmented filter bar, zero-JS static CSV download,
 * and overflow-free responsive table on desktop and mobile.
 */
import LegalLayout from '../../layouts/LegalLayout.astro';
import Icon from '../../components/Icon.astro';
import { MATRIX_ROWS } from '../../lib/legal.ts';
---

<LegalLayout
  title="Matriz de Trazabilidad Normativa — Ulpiano CCO"
  description="Mapeo sistemático entre los 11 Títulos del Anteproyecto, derecho comparado (UE 2023/2841, FISMA 2014, JTC Courts 2025), estándares ISO/IEC y el bloque constitucional venezolano."
  activeSection="matrix"
>
  <!-- 1. COMPACT PAGE HEADER -->
  <section class="ulp-page-header">
    <div class="grid-container">
      <nav class="usa-breadcrumb" aria-label="Migas de pan">
        <ol class="usa-breadcrumb__list">
          <li class="usa-breadcrumb__list-item">
            <a href="/" class="usa-breadcrumb__link">Portal CCO</a>
          </li>
          <li class="usa-breadcrumb__list-item usa-current" aria-current="page">
            <span>Matriz de Trazabilidad</span>
          </li>
        </ol>
      </nav>

      <div class="ulp-page-header__row">
        <div>
          <h1 class="ulp-page-header__title">
            Matriz de Trazabilidad Normativa y Estándares Forenses
          </h1>
          <p class="ulp-page-header__sub">
            11 Títulos + Disposiciones mapeados contra UE 2023/2841, FISMA 2014, JTC Courts 2025,
            ISO/IEC 27001 / 27037 / 42001, CRBV Art. 203, TSJ 0406/2026 y LOCOTA 2026.
          </p>
        </div>

        <div class="display-flex flex-wrap ulp-gap-1 ulp-no-print">
          <a
            href="/matriz/trazabilidad.csv"
            download="Matriz_Trazabilidad_Normativa_V1.2.csv"
            class="usa-button usa-button--small ulp-btn-icon"
            title="Descargar como archivo CSV compatible con Excel (funciona sin JS)"
          >
            <Icon name="download" size={15} />
            <span>Exportar CSV</span>
          </a>
          <a href="/lector/rag-catalog/" class="usa-button usa-button--outline usa-button--small ulp-btn-icon">
            <Icon name="description" size={15} />
            <span>Catálogo RAG (115)</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. UNIFIED FILTER TOOLBAR + RESPONSIVE TABLE -->
  <section class="ulp-band ulp-band--subtle ulp-band--compact">
    <div class="grid-container">
      <div
        id="matrix-feedback-alert"
        class="usa-alert usa-alert--success usa-alert--slim margin-bottom-2"
        role="status"
        aria-live="polite"
        hidden
      >
        <div class="usa-alert__body">
          <p class="usa-alert__text" id="matrix-feedback-text"></p>
        </div>
      </div>

      <div class="ulp-surface ulp-surface--padded margin-bottom-3 ulp-no-print">
        <div class="grid-row grid-gap-2 flex-align-center">
          <div class="tablet:grid-col-6">
            <label class="usa-sr-only" for="matrix-search-input">
              Filtrar por término en la matriz
            </label>
            <input
              class="usa-input width-full maxw-full margin-0"
              id="matrix-search-input"
              type="search"
              name="search"
              placeholder="Filtrar por término (ej. LOCOTA, FISMA, ISO, 0406, 72h, 203)..."
            />
          </div>

          <div class="tablet:grid-col-6 display-flex flex-justify-end flex-wrap flex-align-center ulp-gap-1 margin-top-1 tablet:margin-top-0">
            <span
              class="text-base-darker font-sans-xs margin-right-1 ulp-tabular"
              id="matrix-filter-count"
              aria-live="polite"
            >
              Mostrando <strong>{MATRIX_ROWS.length}</strong> filas
            </span>
            <button
              type="button"
              id="btn-copy-matrix"
              class="usa-button usa-button--outline usa-button--small ulp-btn-icon"
              title="Copiar filas visibles en formato TSV"
            >
              <Icon name="content_copy" size={14} />
              <span>Copiar TSV</span>
            </button>
            <button
              type="button"
              id="btn-print-matrix"
              class="usa-button usa-button--outline usa-button--small ulp-btn-icon"
              title="Imprimir Matriz"
            >
              <Icon name="print" size={14} />
              <span>Imprimir</span>
            </button>
          </div>
        </div>

        <div class="margin-top-2 border-top-1px border-base-lighter padding-top-2">
          <div class="ulp-segmented" role="group" aria-label="Filtro por sección">
            <button
              type="button"
              class="ulp-segmented__item excel-sheet-tab is-active"
              data-sheet="all"
              aria-pressed="true"
            >
              Todas ({MATRIX_ROWS.length})
            </button>
            <button
              type="button"
              class="ulp-segmented__item excel-sheet-tab"
              data-sheet="organica"
              aria-pressed="false"
            >
              Ley Orgánica (Art. 203)
            </button>
            <button
              type="button"
              class="ulp-segmented__item excel-sheet-tab"
              data-sheet="fisma"
              aria-pressed="false"
            >
              FISMA 2014 &amp; UE
            </button>
            <button
              type="button"
              class="ulp-segmented__item excel-sheet-tab"
              data-sheet="original"
              aria-pressed="false"
            >
              Título VII (Anticorrupción)
            </button>
            <button
              type="button"
              class="ulp-segmented__item excel-sheet-tab"
              data-sheet="forense"
              aria-pressed="false"
            >
              Forense ISO 27037 &amp; Sanciones
            </button>
          </div>
        </div>
      </div>

      <div class="ulp-table-wrap" tabindex="0">
        <table
          class="usa-table usa-table--stacked usa-table--striped usa-table--borderless"
          id="matrix-table-main"
        >
          <caption class="usa-sr-only">
            Matriz de trazabilidad entre los 11 títulos normativos, estándares internacionales y bloque constitucional
          </caption>
          <colgroup>
            <col class="ulp-col-num" />
            <col class="ulp-col-title" />
            <col class="ulp-col-scope" />
            <col class="ulp-col-comp" />
            <col class="ulp-col-const" />
            <col class="ulp-col-hier" />
          </colgroup>
          <thead>
            <tr>
              <th scope="col" class="text-center">#</th>
              <th scope="col">Título &amp; Artículos</th>
              <th scope="col">Materia Regulada &amp; Alcance</th>
              <th scope="col">Derecho Comparado / ISO</th>
              <th scope="col">Bloque Constitucional</th>
              <th scope="col" class="text-center">Jerarquía</th>
            </tr>
          </thead>
          <tbody id="matrix-tbody">
            {MATRIX_ROWS.map((row) => (
              <tr
                id={`fila-${row.rowNum}`}
                data-category={row.category}
                class={row.isStar ? 'ulp-row-star' : ''}
              >
                <td class="text-center text-bold font-mono-xs ulp-tabular" data-label="Fila">
                  {row.rowNum}
                </td>
                <td data-label="Título & Artículos">
                  <span class="usa-tag ulp-tag-v12 margin-bottom-05">{row.titleId}</span>
                  <div class="text-bold font-sans-xs text-ink">{row.titleName}</div>
                  <span class="text-base-dark font-sans-2xs">{row.articles}</span>
                </td>
                <td data-label="Materia Regulada & Alcance">
                  <div class="text-bold font-sans-xs text-ink margin-bottom-05">{row.topic}</div>
                  <p class="font-sans-2xs text-base-darker margin-0">{row.scope}</p>
                </td>
                <td data-label="Derecho Comparado / ISO">
                  <ul class="usa-list usa-list--unstyled margin-0 font-sans-2xs">
                    {row.comparativeLaw.map((item) => (
                      <li class="margin-bottom-05">
                        <span
                          class={`usa-tag ${item.isOriginal ? 'ulp-tag-warning' : 'ulp-tag-v12'} margin-right-05`}
                        >
                          {item.tag}
                        </span>
                        <span>{item.detail}</span>
                      </li>
                    ))}
                  </ul>
                </td>
                <td data-label="Bloque Constitucional">
                  <ul class="usa-list usa-list--unstyled margin-0 font-sans-2xs">
                    {row.constitutionalBlock.map((item) => (
                      <li class="margin-bottom-05">
                        <span
                          class={`usa-tag ${item.isImportant ? 'ulp-tag-v11' : 'ulp-tag-v12'} margin-right-05`}
                        >
                          {item.tag}
                        </span>
                        <span class={item.isImportant ? 'text-bold' : ''}>{item.detail}</span>
                      </li>
                    ))}
                  </ul>
                </td>
                <td class="text-center" data-label="Jerarquía">
                  <span
                    class={`usa-tag ${row.hierarchy === 'Orgánica' ? 'ulp-tag-v11' : row.hierarchy === 'Innovación' ? 'ulp-tag-warning' : 'ulp-tag-v12'}`}
                  >
                    {row.hierarchy}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <script>
    import { matchesMatrixSheet } from '../../lib/format.ts';

    let activeSheet = 'all';
    let activeQuery = '';

    const searchInput = document.getElementById('matrix-search-input') as HTMLInputElement | null;
    const countEl = document.getElementById('matrix-filter-count');
    const feedbackAlert = document.getElementById('matrix-feedback-alert');
    const feedbackText = document.getElementById('matrix-feedback-text');
    const tabs = document.querySelectorAll<HTMLButtonElement>('.excel-sheet-tab');

    const applyFilters = () => {
      const rows = document.querySelectorAll<HTMLTableRowElement>('#matrix-tbody tr');
      const q = activeQuery.toLowerCase().trim();
      let visible = 0;

      tabs.forEach((tab) => {
        const isAct = tab.getAttribute('data-sheet') === activeSheet;
        tab.classList.toggle('is-active', isAct);
        tab.setAttribute('aria-pressed', String(isAct));
      });

      rows.forEach((row) => {
        const cat = (row.getAttribute('data-category') || '').toLowerCase();
        const txt = (row.textContent || '').toLowerCase();
        const show = matchesMatrixSheet(cat, txt, activeSheet) && (!q || txt.includes(q));
        row.hidden = !show;
        if (show) visible++;
      });

      if (countEl) {
        countEl.innerHTML =
          q || activeSheet !== 'all'
            ? `Mostrando <strong>${visible}</strong> de <strong>${rows.length}</strong> filas`
            : `Mostrando <strong>${rows.length}</strong> filas`;
      }
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        activeSheet = tab.getAttribute('data-sheet') || 'all';
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', () => {
      activeQuery = searchInput.value;
      applyFilters();
    });

    document.getElementById('btn-print-matrix')?.addEventListener('click', () => window.print());

    document.getElementById('btn-copy-matrix')?.addEventListener('click', async () => {
      const rows = document.querySelectorAll<HTMLTableRowElement>('#matrix-tbody tr');
      let tsv =
        'Fila\tTítulo & Artículos\tMateria Regulada\tDerecho Comparado / Estándares\tBloque Constitucional & Nacional\tJerarquía\n';
      rows.forEach((row) => {
        if (row.hidden) return;
        const cells = row.querySelectorAll('td');
        if (cells.length < 6) return;
        const clean = (cell: Element, sep: string) =>
          (cell.textContent || '').replace(/\s*\r?\n\s*/g, sep).replace(/\s{2,}/g, ' ').trim();
        tsv += `${clean(cells[0], ' ')}\t${clean(cells[1], ' ')}\t${clean(cells[2], ' ')}\t${clean(cells[3], ' | ')}\t${clean(cells[4], ' | ')}\t${clean(cells[5], ' ')}\n`;
      });

      const showMsg = (msg: string, warn = false) => {
        if (!feedbackAlert || !feedbackText) return;
        feedbackAlert.className = `usa-alert usa-alert--${warn ? 'warning' : 'success'} usa-alert--slim margin-bottom-2`;
        feedbackText.textContent = msg;
        feedbackAlert.hidden = false;
        setTimeout(() => {
          feedbackAlert.hidden = true;
        }, 4500);
      };

      try {
        await navigator.clipboard.writeText(tsv);
        showMsg('Matriz copiada al portapapeles en formato TSV compatible con Excel o Calc.');
      } catch {
        showMsg('No se pudo acceder al portapapeles. Utilice el botón Exportar CSV.', true);
      }
    });
  </script>
</LegalLayout>
