---
import '../styles/viewer.css';

const { title, head = '', body = '' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <Fragment set:html={head} />
  </head>
  <body>
    <Fragment set:html={body} />
    <slot />
  </body>
</html>
