---
/**
 * ULPIANO CCO — Master Institutional Layout (100% Native Astro 7, Zero Legacy JS, Light-Only)
 * Zero inline scripts, zero uswds.min.js (78 KB removed), native CSS @view-transition.
 */
import '@uswds/uswds/css/uswds.min.css';
import '../styles/ulpiano-uswds.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Identifier from '../components/Identifier.astro';
import GlobalSearchModal from '../components/GlobalSearchModal.astro';

interface Props {
  title?: string;
  description?: string;
  activeSection?: 'dashboard' | 'diagrams' | 'api' | 'reader' | 'compare' | 'matrix' | 'backend' | 'frontend';
}

const {
  title = 'Ulpiano CCO — Dirección de Ciberseguridad Procesal e Integridad Digital',
  description = 'Portal oficial de ciberseguridad procesal, informática forense e integridad digital del sistema de justicia y de la administración pública.',
  activeSection = 'dashboard',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://ulpiano.sha256.us').toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#004987" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Open Graph & Social Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Ulpiano CCO" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }
    </style>
  </head>
  <body>
    <a class="usa-skipnav" href="#main-content">Saltar al contenido principal</a>

    <div class="usa-overlay" data-nav-overlay></div>

    <Header activeSection={activeSection} />

    <main id="main-content">
      <slot />
    </main>

    <GlobalSearchModal />

    <Footer activeSection={activeSection} />

    <Identifier />
  </body>
</html>
