---
/**
 * USWDS Master Base Layout (Plantilla Maestra Institucional)
 * Fuente oficial: https://designsystem.digital.gov/page-templates/
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Identifier from '../components/Identifier.astro';
import '../../public/assets/uswds/css/uswds.min.css';

interface Props {
  title?: string;
  description?: string;
  activePage?: 'index' | 'backend' | 'frontend';
}

const {
  title = 'Ulpiano CCO — Dirección de Ciberseguridad Procesal e Integridad Digital',
  description = 'Portal oficial de ciberseguridad procesal, informática forense e integridad digital del sistema de justicia y de la administración pública.',
  activePage = 'index',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- USWDS Precompiled Stylesheet & Critical Init Script -->
    <link rel="stylesheet" href="/assets/uswds/css/uswds.min.css" />
    <script is:inline src="/assets/uswds/js/uswds-init.min.js"></script>
  </head>
  <body>
    <!-- 1. Enlace de salto (Skip Navigation) -->
    <a class="usa-skipnav" href="#main-content">
      Saltar al contenido principal
    </a>

    <!-- 2. Overlay oficial USWDS -->
    <div class="usa-overlay"></div>

    <!-- 3. Encabezado Oficial USWDS -->
    <Header activePage={activePage} />

    <!-- 4. Contenedor Principal Único -->
    <main id="main-content">
      <slot />
    </main>

    <!-- 5. Pie de Página Oficial USWDS -->
    <Footer activePage={activePage} />

    <!-- 6. Identificador Institucional Oficial USWDS -->
    <Identifier />

    <!-- 7. Runtime Scripts: USWDS + Engine del Portal -->
    <script is:inline src="/assets/uswds/js/uswds.min.js"></script>
    <script src="../scripts/viewer.js"></script>
  </body>
</html>
