# ==============================================================================
# ULPIANO CCO — Configuración para cPanel / Servidor Apache
# ==============================================================================

# 1. Codificación de caracteres estándar UTF-8
AddDefaultCharset UTF-8

# 2. Tipos MIME para JSON, SVG, CSS, JS y HTML
<IfModule mod_mime.c>
  AddType application/json .json
  AddType image/svg+xml .svg .svgz
  AddType text/html .html
  AddType text/css .css
  AddType application/javascript .js
</IfModule>

# 3. Cache optimizado para carga ultra rápida
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 hour"
  ExpiresByType text/css                  "access plus 30 days"
  ExpiresByType application/javascript    "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/json          "access plus 1 day"
  ExpiresByType text/html                 "access plus 10 minutes"
</IfModule>

# 4. Compresión GZIP / Deflate
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 5. Seguridad y políticas de directorio
Options -Indexes
ServerSignature Off

# 6. Entrada principal
DirectoryIndex index.html

# 7. Cabeceras CORS seguras para peticiones internas
<IfModule mod_headers.c>
  <FilesMatch "\.(json|html|svg)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type"
  </FilesMatch>
</IfModule>
