# ==============================================================================
# ULPIANO CCO — Configuración para cPanel / Servidor Apache (Sincronizado con public/.htaccess)
# ==============================================================================

# 1. Codificación de caracteres estándar UTF-8
AddDefaultCharset UTF-8

# 2. Tipos MIME para JSON, SVG, CSS, JS, HTML y Web App Manifest
<IfModule mod_mime.c>
  AddType application/json .json
  AddType image/svg+xml .svg .svgz
  AddType text/html .html
  AddType text/css .css
  AddType application/javascript .js
  AddType application/manifest+json .webmanifest
</IfModule>

# 3. Cache optimizado para carga ultra rápida
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 hour"
  ExpiresByType text/css                  "access plus 30 days"
  ExpiresByType application/javascript    "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType application/json          "access plus 1 day"
  ExpiresByType text/html                 "access plus 10 minutes"
</IfModule>

# 4. Compresión GZIP / Deflate
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 5. Seguridad y políticas de directorio
Options -Indexes
ServerSignature Off

# 6. Entrada principal
DirectoryIndex index.html

# 7. Cabeceras HTTP de Seguridad (100% self-hosted, sin CDNs externos ni unsafe-inline en scripts)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

  # Content Security Policy estricta: cero scripts inline, cero dependencias de CDN externas
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; object-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"

  # CORS de solo lectura para especificaciones públicas (JSON y SVG)
  <FilesMatch "\.(json|svg)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type"
  </FilesMatch>
</IfModule>
